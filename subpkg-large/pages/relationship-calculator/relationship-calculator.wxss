/* pages/relationship-calculator/relationship-calculator.wxss - 美化版 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
}

/* 顶部显示区 */
.display-area {
  flex: 1;
  padding: 60rpx 30rpx 20rpx;
  background: transparent;
}

.relation-chain-display {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 40rpx;
  line-height: 1.8;
  min-height: 100rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 25rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.chain-item {
  font-size: 44rpx;
  color: #e94560;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(233, 69, 96, 0.3);
}

.chain-de {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.4);
}

.result-area {
  margin-top: 60rpx;
}

.result-line {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 20rpx;
  flex-wrap: wrap;
  background: linear-gradient(135deg, rgba(233, 69, 96, 0.2) 0%, rgba(233, 69, 96, 0.05) 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(233, 69, 96, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(233, 69, 96, 0.2);
}

.result-label {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
}

.result-value {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
  background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 控制栏 */
.control-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.05);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
}

.gender-selector {
  display: flex;
  gap: 30rpx;
}

.gender-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.gender-option.active {
  background: rgba(7, 193, 96, 0.2);
  border-color: #07c160;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.gender-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.gender-check.checked {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-color: #07c160;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.4);
}

.gender-check.checked::after {
  content: '✓';
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.gender-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.gender-option.active .gender-label {
  color: #07c160;
}

.control-icons {
  display: flex;
  gap: 20rpx;
}

.control-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.control-icon:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.15);
}

.icon-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.icon-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 计算器键盘 4x4 布局 */
.calculator-keyboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, 140rpx);
  background: rgba(255, 255, 255, 0.03);
  padding: 20rpx;
  gap: 15rpx;
}

.key-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
  color: #fff;
  font-size: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  transition: all 0.2s ease;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.key-btn:active {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.08) 100%);
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 功能按钮样式 */
.key-func {
  background: linear-gradient(145deg, rgba(102, 126, 234, 0.3) 0%, rgba(102, 126, 234, 0.15) 100%);
  border-color: rgba(102, 126, 234, 0.4);
  font-size: 40rpx;
}

.key-func:active {
  background: linear-gradient(145deg, rgba(102, 126, 234, 0.4) 0%, rgba(102, 126, 234, 0.25) 100%);
}

/* 清空按钮 */
.key-clear {
  background: linear-gradient(145deg, rgba(233, 69, 96, 0.3) 0%, rgba(233, 69, 96, 0.15) 100%);
  border-color: rgba(233, 69, 96, 0.4);
  font-size: 36rpx;
}

.key-clear:active {
  background: linear-gradient(145deg, rgba(233, 69, 96, 0.4) 0%, rgba(233, 69, 96, 0.25) 100%);
}

/* 分享按钮 */
.key-share {
  background: linear-gradient(145deg, rgba(102, 126, 234, 0.3) 0%, rgba(102, 126, 234, 0.15) 100%);
  border-color: rgba(102, 126, 234, 0.4);
  font-size: 48rpx;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.key-share::after {
  border: none;
}

.key-share:active {
  background: linear-gradient(145deg, rgba(102, 126, 234, 0.4) 0%, rgba(102, 126, 234, 0.25) 100%);
}

/* 功能菜单按钮 */
.key-func-menu {
  background: linear-gradient(145deg, rgba(102, 126, 234, 0.3) 0%, rgba(102, 126, 234, 0.15) 100%);
  border-color: rgba(102, 126, 234, 0.4);
  font-size: 48rpx;
}

.key-func-menu:active {
  background: linear-gradient(145deg, rgba(102, 126, 234, 0.4) 0%, rgba(102, 126, 234, 0.25) 100%);
}

/* 等号按钮 - 橙色渐变，占据 2 行 */
.key-equal-double {
  grid-row: span 2;
  background: linear-gradient(135deg, #f37c3e 0%, #e94560 100%);
  border: none;
  font-size: 56rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 32rpx rgba(233, 69, 96, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.key-equal-double:active {
  background: linear-gradient(135deg, #f59159 0%, #ec5d7a 100%);
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(233, 69, 96, 0.3);
}

/* 禁用状态 */
.disabled {
  opacity: 0.3;
  background: rgba(255, 255, 255, 0.02) !important;
  box-shadow: none;
}

/* 功能菜单弹窗 */
.func-menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
  backdrop-filter: blur(4rpx);
}

.func-menu-content {
  background: linear-gradient(180deg, rgba(26, 26, 46, 0.95) 0%, rgba(15, 52, 96, 0.98) 100%);
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.4);
}

.func-menu-item {
  padding: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #fff;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
}

.func-menu-item:active {
  background: rgba(233, 69, 96, 0.2);
}

.func-menu-item:last-child {
  border-bottom: none;
}

/* 关系链解析和智能问答模式 */
.section {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 252, 0.98) 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(102, 126, 234, 0.1);
}

.section-title {
  font-size: 32rpx;
  color: #1a1a2e;
  font-weight: bold;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.section-back {
  font-size: 28rpx;
  color: #667eea;
  padding: 10rpx 24rpx;
  border: 2rpx solid #667eea;
  border-radius: 50rpx;
  background: rgba(102, 126, 234, 0.1);
  transition: all 0.3s ease;
}

.section-back:active {
  background: #667eea;
  color: white;
  transform: scale(0.95);
}

.parse-box,
.ai-box {
  display: flex;
  gap: 15rpx;
  margin-bottom: 10rpx;
}

  .parse-input,
.ai-input {
  flex: 1;
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 12rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  min-height: 80rpx;
  max-height: 160rpx;
  line-height: 1.4;
}

.parse-input:focus,
.ai-input:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
  background: white;
}

  .parse-btn,
.ai-send-btn {
  flex-shrink: 0;
  min-width: 100rpx;
  padding: 12rpx 18rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  align-self: flex-end;
  flex-shrink: 0;
  height: 80rpx;
}
.parse-btn:active,
.ai-send-btn:active {
  background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.2);
}

.parse-result,
.ai-chat-box {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 200rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}

.result-title {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 600;
  margin-bottom: 15rpx;
}

.result-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

  .ai-input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  margin-bottom: 4rpx;
  flex-wrap: nowrap;
  width: 100%;
}

.ai-send-btn {
  flex-shrink: 0;
  min-width: 100rpx;
  padding: 12rpx 18rpx;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  height: 80rpx;
}
.ai-message-item.user {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  margin-left: auto;
}

.ai-message-item.ai {
  background: white;
  color: #333;
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}
