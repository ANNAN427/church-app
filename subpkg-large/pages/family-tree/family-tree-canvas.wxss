/* pages/family-tree/family-tree.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
}

/* 顶部标题 */
.header {
  padding: 20rpx;
  text-align: center;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.header-subtitle {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.header-controls {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 15rpx;
}

.btn-reset, .btn-home {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 12rpx 30rpx;
  font-size: 24rpx;
}

.btn-home {
  background: #f5f5f5;
  color: #666;
}

/* 滚动区域 */
.tree-scroll {
  flex: 1;
  overflow: hidden;
}

.canvas-container {
  position: relative;
  background: white;
}

.family-canvas {
  display: block;
}

.touch-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.touch-node {
  position: absolute;
  width: 80px;
  height: 80px;
  pointer-events: auto;
}

/* 图例说明 */
.legend {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: white;
  padding: 15rpx 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  display: flex;
  gap: 30rpx;
  z-index: 99;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-item text {
  font-size: 22rpx;
  color: #666;
}

.legend-line {
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.legend-line.parent-child {
  background: #4a90d9;
}

.legend-line.spouse {
  background: #e91e63;
}

.legend-line.sibling {
  background: #4a90d9;
  border-style: dashed;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin: 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-go-home {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

/* 十字架弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
}

.cross-modal {
  max-width: 600rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #eee;
}

.modal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

/* 十字架布局 */
.cross-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.cross-top, .cross-bottom {
  width: 100%;
  text-align: center;
}

.cross-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.cross-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.cross-cards-horizontal {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 15rpx;
}

.cross-middle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 20rpx;
}

.cross-current {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff9c4 0%, #fff59d 100%);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 213, 79, 0.5);
}

.cross-left, .cross-right {
  flex: 1;
  text-align: center;
}

.cross-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  min-width: 100rpx;
}

.cross-card-small {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  background: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.cross-avatar {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.cross-avatar.male {
  color: #4a90d9;
}

.cross-avatar.female {
  color: #e91e63;
}

.cross-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.cross-relation {
  font-size: 18rpx;
  color: #666;
}

/* 弹窗底部按钮 */
.modal-footer {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.btn-switch {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
}

.btn-close {
  background: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
}
