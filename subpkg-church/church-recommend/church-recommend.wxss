/* pages/church-recommend/church-recommend.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* Header */
.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 30rpx;
  color: white;
}

.header-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* Search Bar */
.search-bar {
  display: flex;
  align-items: center;
  background: white;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 20rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 36rpx;
  font-size: 28rpx;
}

/* Province Tabs */
.province-tabs {
  white-space: nowrap;
  background: white;
  border-bottom: 1rpx solid #e0e0e0;
}

.tabs-inner {
  display: flex;
  padding: 20rpx 30rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

/* Church List */
.church-list {
  flex: 1;
  padding: 30rpx;
}

.church-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.church-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.church-info {
  margin-bottom: 16rpx;
}

.church-province {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.church-address {
  font-size: 26rpx;
  color: #999;
}

.church-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.church-history {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #ccc;
}

/* Stats Bar */
.stats-bar {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-top: 1rpx solid #e0e0e0;
  font-size: 24rpx;
  color: #999;
}

.stats-filter {
  color: #667eea;
}
