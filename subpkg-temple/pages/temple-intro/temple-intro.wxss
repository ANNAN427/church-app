/* pages/temple-intro/temple-intro.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7f0 0%, #f8faf8 50%, #ffffff 100%);
  padding: 0 24rpx 60rpx;
}

/* Header */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.header-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.header-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2d5a3d;
}
.header-subtitle {
  font-size: 24rpx;
  color: #7a9a7a;
  margin-top: 6rpx;
}
.admin-entry {
  font-size: 22rpx;
  color: #5c6bdc;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: #f0f2ff;
  border-radius: 8rpx;
}

/* Search Bar */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(45, 90, 61, 0.06);
  border: 1rpx solid #e8f5e8;
}
.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-btn {
  font-size: 26rpx;
  color: #fff;
  background: #5c6bdc;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

/* Province Tabs */
.province-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #e8f5e8;
}
.tabs-inner {
  display: inline-flex;
  padding: 8rpx 0;
}
.tab-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 8rpx;
  border-radius: 16rpx;
  background: #f0f7f0;
}
.tab-item.active {
  background: #5c6bdc;
  color: #fff;
  font-weight: 600;
}

/* Temple List */
.temple-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.temple-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(45, 90, 61, 0.06);
  border: 1rpx solid #e8f5e8;
}
.temple-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.temple-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d5a3d;
  margin-bottom: 8rpx;
}
.temple-info {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.temple-province, .temple-address {
  font-size: 24rpx;
  color: #888;
}
.temple-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.tag {
  font-size: 22rpx;
  color: #5c6bdc;
  background: #f0f2ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.temple-features {
  margin-top: 8rpx;
}
.feature-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: #bbb;
}

/* Stats Bar */
.stats-bar {
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #999;
}
.stats-filter {
  color: #5c6bdc;
  margin-left: 8rpx;
}
