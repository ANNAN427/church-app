/* pages/temple-detail/temple-detail.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* Hero Section */
.hero-section {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}
.hero-image {
  width: 100%;
  height: 400rpx;
}

/* Name Header */
.name-header {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.temple-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #2d5a3d;
  margin-bottom: 8rpx;
}
.temple-province {
  font-size: 26rpx;
  color: #888;
}

/* Info Card */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.info-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d5a3d;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row {
  display: flex;
  padding: 10rpx 0;
}
.info-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

/* Content Cards */
.content-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d5a3d;
  margin-bottom: 16rpx;
}
.card-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  white-space: pre-wrap;
  word-wrap: break-word;
}

/* Gallery Card */
.gallery-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.image-gallery {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.gallery-image {
  width: 100%;
  border-radius: 12rpx;
}
.gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}
.gallery-empty .empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.gallery-empty .empty-text {
  font-size: 24rpx;
  color: #999;
}

/* Action Bar */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}
.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
}
.btn-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}
.btn-text {
  font-size: 22rpx;
  color: #666;
}
.action-btn:active {
  opacity: 0.7;
}
