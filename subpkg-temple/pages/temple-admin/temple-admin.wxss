/* pages/temple-admin/temple-admin.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7f0 0%, #f8faf8 50%, #ffffff 100%);
  padding: 0 24rpx 60rpx;
}

/* Admin Header */
.admin-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 20rpx;
}
.header-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}
.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2d5a3d;
}
.header-subtitle {
  font-size: 24rpx;
  color: #7a9a7a;
  margin-top: 6rpx;
}

/* Search Section */
.search-section {
  margin-bottom: 16rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(45, 90, 61, 0.06);
  border: 1rpx solid #e8f5e8;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-btn {
  font-size: 26rpx;
  color: #fff;
  background: #5c6bdc;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  margin-left: 10rpx;
}

/* Result List */
.result-list {
  height: 500rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.result-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.result-item:active {
  background: #f5f5f5;
}
.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d5a3d;
  margin-bottom: 6rpx;
}
.result-info {
  font-size: 24rpx;
  color: #888;
}

/* Edit Form */
.edit-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d5a3d;
}
.form-cancel {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.form-group {
  margin-bottom: 20rpx;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 8rpx;
}
.form-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e8e8e8;
}
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e8e8e8;
  min-height: 120rpx;
}
.form-textarea-large {
  min-height: 200rpx;
}

/* Action Buttons */
.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.preview-btn {
  background: #f0f2ff;
  color: #5c6bdc;
}
.save-btn {
  background: #5c6bdc;
  color: #fff;
}
.action-btn:active {
  opacity: 0.8;
}

/* Image Upload */
.image-preview-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.preview-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #e8e8e8;
}
.preview-img {
  width: 100%;
  height: 100%;
}
.preview-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.upload-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 24rpx;
  background: #e8f5e9;
  color: #2d5a3d;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #c8e6c9;
}
.upload-btn:active {
  opacity: 0.8;
}
.camera-btn {
  background: #fff3e0;
  color: #e65100;
  border-color: #ffe0b2;
}
.upload-hint {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}

/* Form Subsection */
.form-subsection {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e0e0e0;
}
.subsection-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: #bbb;
}
