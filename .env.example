# 拾光赞美诗 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ========== 微信小程序配置 ==========
# 微信小程序 AppID（在微信公众平台获取）
MINIPROGRAM_APPID=wx9c195dc14e24e637

# 微信云开发环境 ID
CLOUD_ENV_ID=cloud1-d5goezig94764ec99

# ========== 阿里云配置 ==========
# 阿里云 DashScope API 密钥（用于 AI 功能）
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-api-key-here

# DashScope API 端点
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ========== 后端 API 配置 ==========
# 后端 API 地址
API_URL=https://your-backend-api.com

# WebSocket 地址
WS_URL=wss://your-websocket-server.com

# API 超时时间（毫秒）
API_TIMEOUT=60000

# ========== 管理员配置 ==========
# 管理后台账号（仅云函数中使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# ========== 其他配置 ==========
# Token 配置
TOKEN_NAME=token
TOKEN_PREFIX=

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 是否启用调试模式
DEBUG=false
