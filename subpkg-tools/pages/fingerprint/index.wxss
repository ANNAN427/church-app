/* ========== 全局容器 ========== */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a1a 0%, #1a1a2e 30%, #16213e 70%, #0f3460 100%);
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  overflow-x: hidden;
}

/* 背景星点装饰 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    radial-gradient(2rpx 2rpx at 20% 30%, rgba(255,255,255,0.3), transparent),
    radial-gradient(2rpx 2rpx at 40% 70%, rgba(255,255,255,0.2), transparent),
    radial-gradient(1rpx 1rpx at 60% 20%, rgba(255,255,255,0.4), transparent),
    radial-gradient(1rpx 1rpx at 80% 50%, rgba(255,255,255,0.3), transparent),
    radial-gradient(2rpx 2rpx at 10% 80%, rgba(255,255,255,0.2), transparent),
    radial-gradient(1rpx 1rpx at 90% 10%, rgba(255,255,255,0.3), transparent);
  pointer-events: none;
  z-index: 0;
  animation: twinkle 4s ease-in-out infinite alternate;
}

@keyframes twinkle {
  0% { opacity: 0.5; }
  100% { opacity: 1; }
}

/* ========== 导航栏 ========== */
.nav-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.nav-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-icon {
  font-size: 28rpx;
  color: #f5c542;
  animation: pulse-icon 2s ease-in-out infinite;
}

@keyframes pulse-icon {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

.title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  background: linear-gradient(90deg, #f5c542, #ffd700, #f5c542);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ========== 引导区域 ========== */
.guide-section {
  background: transparent;
  border: none;
  padding: 16rpx 10rpx;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.guide-cards {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.guide-card {
  flex: 1;
  max-width: 300rpx;
  height: 260rpx;
  border-radius: 16rpx;
}

/* ========== 性别选择 ========== */
.gender-section {
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.gender-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 16rpx;
}

.gender-toggle {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.gender-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 50rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.gender-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(245, 197, 66, 0.3), rgba(232, 168, 46, 0.1));
  opacity: 0;
  transition: opacity 0.3s;
}

.gender-item.active::before {
  opacity: 1;
}

.gender-item.active {
  border-color: #f5c542;
  box-shadow: 0 8rpx 32rpx rgba(245, 197, 66, 0.3);
  transform: translateY(-4rpx);
}

.gender-emoji {
  font-size: 48rpx;
  position: relative;
  z-index: 1;
}

.gender-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
  position: relative;
  z-index: 1;
}

.gender-item.active .gender-text {
  color: #1a1a2e;
}

.gender-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  position: relative;
  z-index: 1;
}

.gender-item.active .gender-hint {
  color: rgba(26, 26, 46, 0.6);
}


/* ========== 性别图标容器和对勾 ========== */
.gender-icon-inner {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.gender-checkmark {
  position: absolute;
  top: -4rpx;
  right: -16rpx;
  width: 32rpx;
  height: 32rpx;
  background: #f5c542;
  color: #1a1a2e;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(245, 197, 66, 0.5);
  z-index: 10;
}

.active-label {
  color: #1a1a2e !important;
  font-weight: 600;
}

/* ========== 引导提示 ========== */
.guide-tip {
  background: linear-gradient(135deg, rgba(245, 197, 66, 0.2), rgba(232, 168, 46, 0.1));
  border: 1rpx solid rgba(245, 197, 66, 0.3);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  position: relative;
  z-index: 1;
  animation: tip-glow 2s ease-in-out infinite alternate;
}

@keyframes tip-glow {
  0% { box-shadow: 0 4rpx 12rpx rgba(245, 197, 66, 0.2); }
  100% { box-shadow: 0 8rpx 24rpx rgba(245, 197, 66, 0.4); }
}

.guide-tip-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.highlight-finger {
  color: #f5c542;
  font-weight: 700;
  font-size: 32rpx;
  animation: highlight-pulse 1.5s ease-in-out infinite;
}

@keyframes highlight-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.tip-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ========== 进度条 ========== */
.progress-section {
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f5c542, #ffd700);
  border-radius: 4rpx;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 12rpx rgba(245, 197, 66, 0.5);
}

.progress-dots {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
}

.progress-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.progress-dot.active {
  border-color: #f5c542;
  background: rgba(245, 197, 66, 0.2);
  box-shadow: 0 0 16rpx rgba(245, 197, 66, 0.4);
  animation: dot-active 1s ease-in-out infinite;
}

@keyframes dot-active {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.progress-dot.done {
  border-color: #4ade80;
  background: rgba(74, 222, 128, 0.2);
}

.dot-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 600;
}

.progress-dot.active .dot-label {
  color: #f5c542;
}

.progress-dot.done .dot-label {
  color: #4ade80;
}

/* ========== 手型区域 ========== */
.hand-wrapper {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
  min-height: 600rpx;
}
.hand-container {
  position: relative;
  width: 100%;
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* 手型图片 */
.hand-img {
  width: 600rpx;
  height: 600rpx;
  flex-shrink: 0;
}

/* ========== 硬币按钮 ========== */
.coin-btn {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 10;
  pointer-events: auto;
}

/* ========== 硬币 ========== */
.coin {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.coin.flipping {
  animation: coin-flip 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes coin-flip {
  0% { transform: rotateY(0deg); }
  50% { transform: rotateY(180deg) scale(1.1); }
  100% { transform: rotateY(360deg); }
}

/* 斗 - 正面朝上 */
.coin.show-front {
  transform: rotateY(0deg);
}

/* 簸箕 - 背面朝上 */
.coin.show-back {
  transform: rotateY(180deg);
}

.coin-face {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.3),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
}

/* 正面 - 斗 */
.coin-front {
  background: linear-gradient(135deg, #f5c542 0%, #d4a017 50%, #f5c542 100%);
  border: 3rpx solid #ffd700;
}

.coin-front::before {
  content: '';
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 215, 0, 0.5);
}

/* 背面 - 簸箕 */
.coin-back {
  background: linear-gradient(135deg, #64b4ff 0%, #4a90d9 50%, #64b4ff 100%);
  border: 3rpx solid #87ceeb;
  transform: rotateY(180deg);
}

.coin-back::before {
  content: '';
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(135, 206, 235, 0.5);
}

/* 空状态 - 未选择（金色金币） */
.coin-empty {
  background: linear-gradient(135deg, #f5c542 0%, #d4a017 50%, #f5c542 100%);
  border: 3rpx solid #ffd700;
}

.coin-empty::before {
  content: '';
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 215, 0, 0.5);
}

.coin-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #1a1a2e;
  z-index: 1;
}

.coin-empty-text {
  color: #ddd;
  font-size: 20rpx;
}

/* 发光效果 - 当前手指 */
.coin.glowing {
  animation: coin-glow 1.5s ease-in-out infinite;
}

@keyframes coin-glow {
  0%, 100% {
    filter: drop-shadow(0 0 8rpx rgba(245, 197, 66, 0.6));
  }
  50% {
    filter: drop-shadow(0 0 20rpx rgba(245, 197, 66, 1));
  }
}

/* ========== 预览区域 ========== */
.preview-section {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.preview-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 16rpx;
}

.preview-tags {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  flex-wrap: nowrap;
}

.preview-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  min-width: 0;
  flex: 1;
  max-width: 130rpx;
  gap: 4rpx;
}

.tag-dou {
  background: linear-gradient(135deg, rgba(245, 197, 66, 0.2), rgba(245, 197, 66, 0.1));
  border: 1rpx solid rgba(245, 197, 66, 0.3);
}

.tag-ji {
  background: linear-gradient(135deg, rgba(100, 180, 255, 0.2), rgba(100, 180, 255, 0.1));
  border: 1rpx solid rgba(100, 180, 255, 0.3);
}

.tag-empty {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx dashed rgba(255, 255, 255, 0.2);
}

.tag-finger {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
}

.tag-value {
  font-size: 24rpx;
  font-weight: 700;
}

.tag-dou .tag-value {
  color: #f5c542;
}

.tag-ji .tag-value {
  color: #64b4ff;
}

.tag-empty .tag-value {
  color: rgba(255, 255, 255, 0.3);
}

/* ========== 提交按钮 ========== */
.submit-section {
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
  animation: fade-in-up 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fade-in-up {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #f5c542 0%, #e8a82e 50%, #d4a017 100%);
  border: none;
  border-radius: 50rpx;
  box-shadow:
    0 8rpx 32rpx rgba(245, 197, 66, 0.4),
    0 0 60rpx rgba(245, 197, 66, 0.2);
  position: relative;
  overflow: hidden;
}

.submit-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.2) 50%, transparent 70%);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.submit-icon {
  font-size: 32rpx;
  color: #1a1a2e;
  animation: pulse-icon 2s ease-in-out infinite;
}

.submit-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 4rpx;
}
