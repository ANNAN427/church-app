/* ========== 全局容器 ========== */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a1a 0%, #1a1a2e 30%, #16213e 70%, #0f3460 100%);
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  position: relative;
}

/* ========== 导航栏 ========== */
.nav-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 64rpx;
  margin-bottom: 24rpx;
}

.back-icon {
  position: absolute;
  left: 10rpx;
  padding: 16rpx;
  z-index: 10;
}

.back-arrow {
  font-size: 56rpx;
  color: #f5c542;
  font-weight: 700;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(90deg, #f5c542, #ffd700, #f5c542);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 4rpx;
}

/* ========== 结果总览卡片 ========== */
.result-content {
  margin-top: 10rpx;
}

.result-header {
  background: linear-gradient(135deg, rgba(245, 197, 66, 0.15) 0%, rgba(232, 168, 46, 0.08) 100%);
  border: 2rpx solid rgba(245, 197, 66, 0.3);
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 28rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  animation: fade-in-down 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fade-in-down {
  0% { opacity: 0; transform: translateY(-20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.result-header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(ellipse at center, rgba(245, 197, 66, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.header-decoration {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.deco-icon {
  font-size: 24rpx;
  color: #f5c542;
  animation: pulse-icon 2s ease-in-out infinite;
}

@keyframes pulse-icon {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

.result-type {
  display: block;
  font-size: 36rpx;
  color: #f5c542;
  font-weight: 700;
  text-align: center;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.header-divider {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(245, 197, 66, 0.5), transparent);
  margin: 16rpx auto;
}

.result-summary {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
  text-align: justify;
  padding: 0 10rpx;
}

.dou-count-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #f5c542, #e8a82e);
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 197, 66, 0.4);
}

.badge-text {
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 700;
}

/* ========== 手指组合 ========== */
.finger-combo-section {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  animation: fade-in 0.6s 0.1s both;
}

@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.combo-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 16rpx;
}

.combo-tags {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.combo-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  min-width: 90rpx;
  gap: 4rpx;
}

.combo-finger {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.combo-value {
  font-size: 26rpx;
  font-weight: 700;
}

.value-dou {
  color: #f5c542;
}

.value-ji {
  color: #64b4ff;
}

.value-empty {
  color: rgba(255, 255, 255, 0.3);
}

/* ========== 结果区域通用 ========== */
.result-section {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  animation: fade-in 0.6s both;
}

.result-section:nth-child(2) { animation-delay: 0.15s; }
.result-section:nth-child(3) { animation-delay: 0.2s; }
.result-section:nth-child(4) { animation-delay: 0.25s; }
.result-section:nth-child(5) { animation-delay: 0.3s; }
.result-section:nth-child(6) { animation-delay: 0.35s; }
.result-section:nth-child(7) { animation-delay: 0.4s; }

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 28rpx;
  color: #f5c542;
  font-weight: 700;
}

.section-content {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.9;
  text-align: justify;
  padding-left: 8rpx;
}

/* 诗词特殊样式 */
.poetry-section {
  background: linear-gradient(135deg, rgba(100, 180, 255, 0.08), rgba(100, 180, 255, 0.03));
  border-color: rgba(100, 180, 255, 0.2);
}

.poetry-content {
  text-align: center;
  font-style: italic;
  color: rgba(200, 200, 220, 0.9);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 运势特殊样式 */
.fortune-section {
  background: linear-gradient(135deg, rgba(245, 197, 66, 0.08), rgba(245, 197, 66, 0.03));
  border-color: rgba(245, 197, 66, 0.2);
}

.fortune-content {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* ========== 操作按钮 ========== */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
  animation: fade-in-up 0.5s 0.5s both;
}

@keyframes fade-in-up {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  position: relative;
  overflow: hidden;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  letter-spacing: 2rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #f5c542 0%, #e8a82e 50%, #d4a017 100%);
  color: #1a1a2e;
  box-shadow: 0 8rpx 32rpx rgba(245, 197, 66, 0.4);
}

.action-btn.primary::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.15) 50%, transparent 70%);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

/* ========== 免责声明 ========== */
.disclaimer {
  text-align: center;
  padding: 30rpx 0;
  margin-top: 10rpx;
}

.disclaimer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.5);
}

.empty-btn {
  margin-top: 20rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #f5c542, #e8a82e);
  border-radius: 48rpx;
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}
