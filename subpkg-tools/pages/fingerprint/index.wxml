<view class="container">
  <!-- 指纹图案说明 -->
  <view class="guide-section">
    <view class="guide-cards">
      <image src="https://1689.1r1zhux.com/beads/dou-new.svg" class="guide-card" mode="aspectFit"></image>
      <image src="https://1689.1r1zhux.com/beads/ji-new.svg" class="guide-card" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 性别选择 -->
  <view class="gender-section">
    <view class="gender-label">选择性别</view>
    <view class="gender-toggle">
      <view class="gender-item {{genderValue===0?'active':''}}" data-val="0" bindtap="setGender">
        <view class="gender-icon-inner">
          <text class="gender-emoji">👨</text>
          <view class="gender-checkmark" wx:if="{{genderValue===0}}">✓</view>
        </view>
        <text class="gender-text {{genderValue===0?'active-label':''}}">男</text>
        <text class="gender-hint">看左手</text>
      </view>
      <view class="gender-item {{genderValue===1?'active':''}}" data-val="1" bindtap="setGender">
        <view class="gender-icon-inner">
          <text class="gender-emoji">👩</text>
          <view class="gender-checkmark" wx:if="{{genderValue===1}}">✓</view>
        </view>
        <text class="gender-text {{genderValue===1?'active-label':''}}">女</text>
        <text class="gender-hint">看右手</text>
      </view>
    </view>
  </view>

  <!-- 操作引导 -->
  <view class="guide-tip" wx:if="{{currentFingerIndex<5}}">
    <text class="guide-tip-text">请点击 <text class="highlight-finger">{{fingerNames[currentFingerIndex]}}</text> 上的金币</text>
    <text class="tip-sub">每根手指可点击切换：斗 → 簸箕</text>
  </view>

  <!-- 进度条 -->
  <view class="progress-section">
    <view class="progress-bar">
      <view class="progress-fill" style="width:{{progressPercent}}%"></view>
    </view>
    <view class="progress-dots">
      <view class="progress-dot {{fingerprints[0].value!=='s'?'done':''}} {{currentFingerIndex===0?'active':''}}" data-index="0" bindtap="jumpToFinger">
        <text class="dot-label">{{genderValue==0?'拇':'小'}}</text>
      </view>
      <view class="progress-dot {{fingerprints[1].value!=='s'?'done':''}} {{currentFingerIndex===1?'active':''}}" data-index="1" bindtap="jumpToFinger">
        <text class="dot-label">{{genderValue==0?'食':'无'}}</text>
      </view>
      <view class="progress-dot {{fingerprints[2].value!=='s'?'done':''}} {{currentFingerIndex===2?'active':''}}" data-index="2" bindtap="jumpToFinger">
        <text class="dot-label">中</text>
      </view>
      <view class="progress-dot {{fingerprints[3].value!=='s'?'done':''}} {{currentFingerIndex===3?'active':''}}" data-index="3" bindtap="jumpToFinger">
        <text class="dot-label">{{genderValue==0?'无':'食'}}</text>
      </view>
      <view class="progress-dot {{fingerprints[4].value!=='s'?'done':''}} {{currentFingerIndex===4?'active':''}}" data-index="4" bindtap="jumpToFinger">
        <text class="dot-label">{{genderValue==0?'小':'拇'}}</text>
      </view>
    </view>
  </view>

  <!-- 手型区域 -->
  <view class="hand-wrapper">
    <!-- 男手 -->
    <view class="hand-container" wx:if="{{genderValue==0}}">
      <image src="data:image/jpeg;base64," mode="aspectFit" style="width:600rpx;height:600rpx;flex-shrink:0;"></image>
      <view class="coin-btn" style="top:36%;left:14%" bindtap="onClick" data-index="0">
        <view class="coin {{fingerClass[0]}} {{currentFingerIndex===0?'glowing':''}} {{isFlipping&&flippingIndex===0?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[0].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[0].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[0].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:8%;left:36%" bindtap="onClick" data-index="1">
        <view class="coin {{fingerClass[1]}} {{currentFingerIndex===1?'glowing':''}} {{isFlipping&&flippingIndex===1?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[1].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[1].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[1].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:3%;left:48%" bindtap="onClick" data-index="2">
        <view class="coin {{fingerClass[2]}} {{currentFingerIndex===2?'glowing':''}} {{isFlipping&&flippingIndex===2?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[2].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[2].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[2].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:11%;left:62%" bindtap="onClick" data-index="3">
        <view class="coin {{fingerClass[3]}} {{currentFingerIndex===3?'glowing':''}} {{isFlipping&&flippingIndex===3?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[3].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[3].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[3].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:22%;left:78%" bindtap="onClick" data-index="4">
        <view class="coin {{fingerClass[4]}} {{currentFingerIndex===4?'glowing':''}} {{isFlipping&&flippingIndex===4?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[4].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[4].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[4].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
    </view>

    <!-- 女手 -->
    <view class="hand-container" wx:if="{{genderValue==1}}">
      <image src="data:image/jpeg;base64," mode="aspectFit" style="width:600rpx;height:600rpx;flex-shrink:0;"></image>
      <view class="coin-btn" style="top:36%;left:86%" bindtap="onClick" data-index="0">
        <view class="coin {{fingerClass[0]}} {{currentFingerIndex===0?'glowing':''}} {{isFlipping&&flippingIndex===0?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[0].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[0].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[0].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:8%;left:64%" bindtap="onClick" data-index="1">
        <view class="coin {{fingerClass[1]}} {{currentFingerIndex===1?'glowing':''}} {{isFlipping&&flippingIndex===1?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[1].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[1].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[1].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:3%;left:52%" bindtap="onClick" data-index="2">
        <view class="coin {{fingerClass[2]}} {{currentFingerIndex===2?'glowing':''}} {{isFlipping&&flippingIndex===2?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[2].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[2].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[2].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:11%;left:38%" bindtap="onClick" data-index="3">
        <view class="coin {{fingerClass[3]}} {{currentFingerIndex===3?'glowing':''}} {{isFlipping&&flippingIndex===3?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[3].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[3].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[3].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
      <view class="coin-btn" style="top:22%;left:22%" bindtap="onClick" data-index="4">
        <view class="coin {{fingerClass[4]}} {{currentFingerIndex===4?'glowing':''}} {{isFlipping&&flippingIndex===4?'flipping':''}}">
          <view class="coin-face coin-front" wx:if="{{fingerprints[4].value!=='s'}}"><text class="coin-text">斗</text></view>
          <view class="coin-face coin-empty" wx:if="{{fingerprints[4].value==='s'}}"></view>
          <view class="coin-face coin-back" wx:if="{{fingerprints[4].value==='x'}}"><text class="coin-text">簸</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 已选结果预览 -->
  <view class="preview-section" wx:if="{{completedCount>0}}">
    <view class="preview-title">已选结果</view>
    <view class="preview-tags">
      <view class="preview-tag {{item.value==='o'?'tag-dou':item.value==='x'?'tag-ji':'tag-empty'}}" wx:for="{{fingerprints}}" wx:key="index">
        <text class="tag-finger">{{fingerNames[index]}}</text>
        <text class="tag-value">{{item.value==='o'?'斗':item.value==='x'?'簸':'?'}}</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section" wx:if="{{allDone}}">
    <button class="submit-btn" bindtap="submit">
      <text class="submit-icon">✦</text>
      <text class="submit-text">开始测算</text>
      <text class="submit-icon">✦</text>
    </button>
  </view>
</view>
