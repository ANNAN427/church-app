}

.letter-view-btn {
  padding: 16rpx 50rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  text-align: center;
}

.delete-btn {
  background: rgba(255, 100, 100, 0.15);
  border: 1rpx solid rgba(255, 100, 100, 0.2);
  color: #ff8888;
}

.close-view-btn {
