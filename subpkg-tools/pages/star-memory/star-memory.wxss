}

.memorial-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(100, 150, 255, 0.05);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  color: #ffd700;
  font-size: 44rpx;
  font-weight: bold;
  text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.3);
}

.stat-label {
  color: rgba(180, 200, 255, 0.6);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(100, 150, 255, 0.15);
}

.memorial-anniversary {
  text-align: center;
  padding: 20rpx;
  background: rgba(255, 200, 100, 0.05);
  border-radius: 12rpx;
}

.anniversary-text {
  color: rgba(255, 200, 100, 0.8);
  font-size: 26rpx;
}

.memorial-footer {
  text-align: center;
}

.memorial-close-btn {
  display: inline-block;
  padding: 20rpx 80rpx;
  background: linear-gradient(135deg, rgba(255, 200, 100, 0.15), rgba(255, 150, 100, 0.15));
  border: 1rpx solid rgba(255, 200, 100, 0.2);
  border-radius: 40rpx;
  color: #ffcc66;
  font-size: 30rpx;
}

/* 写信弹窗 */
