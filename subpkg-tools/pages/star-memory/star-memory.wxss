/* pages/star-memory/star-memory.wxss */
.star-memory-page {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #0a0a2e;
}

.star-canvas {
  width: 100%;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1;
}

.tip-text {
  position: fixed;
  bottom: 200rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  z-index: 2;
}

.tip-main {
  color: rgba(220, 230, 255, 0.8);
  font-size: 32rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
  text-shadow: 0 0 20rpx rgba(100, 150, 255, 0.5);
}

.tip-sub {
  color: rgba(180, 200, 255, 0.5);
  font-size: 24rpx;
  margin-top: 16rpx;
}

/* 守护星列表区域 */
.guardian-list {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: auto;
  min-height: 160rpx;
  padding: 20rpx 0 20rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  z-index: 50;
  background: linear-gradient(to top, rgba(10, 10, 46, 0.6) 0%, rgba(10, 10, 46, 0.3) 50%, transparent 100%);
}

/* 头部 */
.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}

.list-title {
  color: #ffd700;
  font-size: 28rpx;
  font-weight: bold;
}

/* 星星横向滚动区 */
.stars-scroll {
  width: 100%;
  max-width: 100%;
  white-space: nowrap;
  padding: 0 10rpx;
  margin-bottom: 0;
}

.stars-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  padding: 10rpx 10rpx 12rpx;
}

.star-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 4rpx 6rpx;
}

.star-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  background: radial-gradient(circle, #ffd700, #ff8c00);
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.6);
  animation: twinkle 3s ease-in-out infinite;
}

.star-circle:nth-child(odd) {
  animation-delay: 0.5s;
}

.star-circle.custom {
  background: radial-gradient(circle, rgba(255, 200, 100, 0.25) 0%, rgba(150, 100, 255, 0.1) 100%);
  box-shadow: 0 0 20rpx rgba(255, 200, 100, 0.3), inset 0 0 15rpx rgba(255, 255, 255, 0.1);
}

.star-circle.add-icon {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(255, 165, 0, 0.15));
  border: 2rpx dashed rgba(255, 215, 0, 0.5);
  font-size: 44rpx;
  color: #FFD700;
  box-shadow: none;
  animation: none;
}

.star-name {
  color: rgba(220, 230, 255, 0.85);
  font-size: 20rpx;
  text-align: center;
  max-width: 90rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.create-star-btn .star-name {
  color: #FFD700;
  font-size: 20rpx;
  font-weight: 500;
  max-width: 120rpx;
}

@keyframes twinkle {
  0%, 100% { box-shadow: 0 0 20rpx rgba(100, 150, 255, 0.3), inset 0 0 15rpx rgba(255, 255, 255, 0.1); }
  50% { box-shadow: 0 0 30rpx rgba(100, 150, 255, 0.5), inset 0 0 20rpx rgba(255, 255, 255, 0.15); }
}

/* 详情列表区 */
.detail-section {
  padding: 0 20rpx;
}

.section-label {
  display: block;
  color: rgba(180, 200, 255, 0.6);
  font-size: 26rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.person-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(100, 150, 255, 0.08);
}

.person-item:active {
  background: rgba(100, 150, 255, 0.1);
}

.person-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3a3a6e, #5a5a8e);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffd700;
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.person-avatar.custom-star {
  background: linear-gradient(135deg, #4a3a6e, #6a5a8e);
}

.person-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.person-name {
  color: rgba(220, 230, 255, 0.9);
  font-size: 30rpx;
  font-weight: 500;
}

.person-dates {
  color: rgba(180, 200, 255, 0.5);
  font-size: 22rpx;
  margin-top: 6rpx;
}

.person-arrow {
  color: rgba(180, 200, 255, 0.4);
  font-size: 36rpx;
  margin-left: 16rpx;
}

.person-actions {
  padding: 10rpx 16rpx;
}

.action-icon {
  color: rgba(180, 200, 255, 0.5);
  font-size: 32rpx;
}

/* 空状态 */
.date-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cal-type-tag {
  padding: 12rpx 20rpx;
  background: rgba(255, 215, 0, 0.12);
  border: 1rpx solid rgba(255, 215, 0, 0.25);
  border-radius: 16rpx;
  color: #FFD700;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
  min-width: 80rpx;
}

.cal-type-tag:active {
  background: rgba(255, 215, 0, 0.2);
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: rgba(180, 200, 255, 0.5);
}

.empty-tip text:first-child {
  margin-bottom: 12rpx;
  font-size: 32rpx;
}

.empty-create-btn {
  margin-top: 30rpx;
  padding: 18rpx 56rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: 40rpx;
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 0 24rpx rgba(255, 215, 0, 0.4);
}

.empty-create-btn:active {
  transform: scale(0.96);
}

/* 详情弹窗 */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(5, 5, 25, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999 !important;
}

.detail-card {
  width: 80%;
  max-height: 70vh;
  overflow-y: auto;
  background: linear-gradient(135deg, #1a1a3e 0%, #2a2a5e 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  padding-bottom: 30rpx;
  box-shadow: 0 0 60rpx rgba(100, 150, 255, 0.3);
  border: 1rpx solid rgba(100, 150, 255, 0.2);
  transform: translateZ(0);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(100, 150, 255, 0.15);
}

.detail-name {
  color: #ffd700;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.5);
}

.detail-close {
  color: rgba(200, 220, 255, 0.6);
  font-size: 36rpx;
  padding: 10rpx;
}

.detail-body {
  margin-bottom: 30rpx;
}

.detail-info {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(100, 150, 255, 0.1);
}

.info-label {
  color: rgba(180, 200, 255, 0.7);
  font-size: 28rpx;
}

.info-value {
  color: rgba(220, 230, 255, 0.9);
  font-size: 28rpx;
  max-width: 60%;
  text-align: right;
}

.detail-edit-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.edit-date-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.06);
  color: #FFD700;
  border: 1rpx solid rgba(255, 215, 0, 0.25);
}

.edit-date-btn:active {
  background: rgba(255, 215, 0, 0.15);
}

.edit-letter-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  background: linear-gradient(135deg, rgba(147, 100, 255, 0.25), rgba(100, 160, 255, 0.25));
  color: #C4B5FD;
  border: 1rpx solid rgba(167, 139, 250, 0.35);
}

.edit-letter-btn:active {
  background: rgba(167, 139, 250, 0.3);
}

.memorial-btn {
  background: linear-gradient(135deg, rgba(255, 150, 100, 0.2), rgba(255, 200, 100, 0.2));
  border: 1rpx solid rgba(255, 200, 100, 0.3);
  color: #ffcc66;
}

.letter-btn {
  background: linear-gradient(135deg, rgba(100, 150, 255, 0.2), rgba(150, 100, 255, 0.2));
  border: 1rpx solid rgba(150, 100, 255, 0.3);
  color: #b8a9ff;
}

/* 纪念日弹窗 */
.memorial-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(5, 5, 25, 1);
