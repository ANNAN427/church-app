}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  background: rgba(100, 150, 255, 0.05);
  border: 1rpx solid rgba(150, 100, 255, 0.15);
  border-radius: 12rpx;
  color: rgba(220, 230, 255, 0.9);
  font-size: 28rpx;
