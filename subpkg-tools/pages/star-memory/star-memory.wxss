  border-radius: 24rpx;
  color: rgba(180, 200, 255, 0.8);
  font-size: 28rpx;
}

.create-submit {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 150, 100, 0.2));
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  border-radius: 24rpx;
  color: #ffd700;
  font-size: 28rpx;
  font-weight: 500;
}

