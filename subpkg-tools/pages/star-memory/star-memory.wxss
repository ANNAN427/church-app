.letter-history-card {
  width: 85%;
  max-height: 75vh;
  background: linear-gradient(180deg, #1a1a3e 0%, #0f0f2f 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 0 80rpx rgba(150, 100, 255, 0.2);
  border: 1rpx solid rgba(150, 100, 255, 0.15);
  overflow: hidden;
  transform: translateZ(0);
}

.letter-history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(150, 100, 255, 0.15);
}

.letter-history-title {
  color: #ffd700;
  font-size: 32rpx;
  font-weight: bold;
}

.letter-history-close {
  color: rgba(200, 220, 255, 0.6);
  font-size: 32rpx;
  padding: 10rpx;
}

.letter-history-body {
  max-height: 55vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.history-empty {
  text-align: center;
  padding: 60rpx 0;
  color: rgba(200, 220, 255, 0.5);
}

.history-item {
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(150, 100, 255, 0.1);
}

.history-date {
  display: block;
  color: #9370db;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.history-preview {
  display: block;
  color: rgba(200, 220, 255, 0.8);
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.letter-history-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(150, 100, 255, 0.15);
}

.letter-history-btn {
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #9370db, #6a5acd);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
}
