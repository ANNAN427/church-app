  box-shadow: 0 0 80rpx rgba(255, 200, 100, 0.15);
  border: 1rpx solid rgba(255, 200, 100, 0.15);
  transform: translateZ(0);
}

.memorial-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.memorial-name {
  color: #ffd700;
  font-size: 48rpx;
  font-weight: bold;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.5);
}

.memorial-subtitle {
  color: rgba(255, 215, 0, 0.6);
  font-size: 28rpx;
  margin-top: 10rpx;
}

.memorial-body {
  margin-bottom: 40rpx;
}

.memorial-dates {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.memorial-date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.date-label {
  color: rgba(180, 200, 255, 0.6);
