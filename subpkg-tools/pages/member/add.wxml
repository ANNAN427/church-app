<!--pages/member/add.wxml - 修复配偶添加界面-->
<view class="container">
  <view class="form-section">
    <view class="form-title">添加{{typeText}}</view>
    
    <!-- 添加方式选择（当前人不需要） -->
    <view class="form-item" wx:if="{{type !== 'current'}}">
      <text class="form-label">添加方式</text>
      <view class="mode-selector">
        <view class="mode-option {{addMode === 'link' ? 'selected' : ''}}" bindtap="setAddMode" data-mode="link">
          <view class="mode-icon">🔗</view>
          <view class="mode-text">关联现有</view>
        </view>
        <view class="mode-option {{addMode === 'new' ? 'selected' : ''}}" bindtap="setAddMode" data-mode="new">
          <view class="mode-icon">➕</view>
          <view class="mode-text">新建成员</view>
        </view>
      </view>
    </view>

    <!-- 关系类型选择（当前人不需要） -->
    <view class="form-item" wx:if="{{type !== 'current'}}">
      <text class="form-label">关系类型</text>
      <view class="relation-grid">
        <view class="relation-option {{selectedRelation.type === item.type && selectedRelation.nature === item.nature ? 'selected' : ''}}" 
              wx:for="{{relationOptions}}" wx:key="type"
              bindtap="selectRelation" data-type="{{item.type}}" data-nature="{{item.nature}}" data-gender="{{item.gender}}">
          <view class="relation-icon">{{item.icon}}</view>
          <view class="relation-name">{{relationNamePrefix}}{{item.name}}</view>
        </view>
      </view>
    </view>

    <!-- 新建成员表单 -->
    <view wx:if="{{addMode === 'new' || type === 'current'}}">
      <view class="form-item">
        <text class="form-label">姓名 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入姓名" value="{{memberName}}" bindinput="onNameInput"/>
      </view>

      <!-- 配偶类型不显示性别选择，自动识别 -->
      <view class="form-item" wx:if="{{type !== 'spouse'}}">
        <text class="form-label">性别</text>
        <picker mode="selector" range="{{['男', '女']}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="form-picker">{{genderText}}</view>
        </picker>
      </view>
      
      <!-- 配偶类型显示自动识别的性别提示 -->
      <view class="form-item" wx:if="{{type === 'spouse'}}">
        <text class="form-label">性别</text>
        <view class="form-picker-disabled">{{genderText}}</view>
      </view>

      <view class="form-item">
        <text class="form-label">出生日期</text>
        <picker mode="date" value="{{birthDate}}" bindchange="onBirthChange">
          <view class="form-picker">{{birthDate || '选择日期'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">状态 <text class="required">*</text></text>
        <picker mode="selector" range="{{['在世', '已故']}}" value="{{statusIndex}}" bindchange="onStatusChange">
          <view class="form-picker">{{statusText}}</view>
        </picker>
      </view>
    </view>

    <!-- 关联现有成员 -->
    <view wx:if="{{addMode === 'link'}}">
      <view class="form-item">
        <text class="form-label">选择成员 <text class="required">*</text></text>
        <picker mode="selector" range="{{existingMembers}}" range-key="name" value="{{selectedMemberIndex}}" bindchange="onMemberSelect">
          <view class="form-picker">{{selectedMemberIndex >= 0 ? existingMembers[selectedMemberIndex].name : '请选择成员'}}</view>
        </picker>
      </view>
      
      <view class="link-hint">
        <text>💡 提示：关联现有成员将自动建立{{selectedRelation.type === 'father' || selectedRelation.type === 'mother' ? '长辈' : '亲属'}}关系</text>
      </view>
    </view>

    <button class="btn-save" bindtap="saveMember">保存</button>
  </view>
</view>
