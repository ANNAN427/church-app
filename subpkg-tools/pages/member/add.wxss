/* pages/member/add.wxss */
.container {
  padding: 30rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}

.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.form-title {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  color: #555;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.relation-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.relation-option {
  background: #f8f9fa;
  border: 3rpx solid #e0e0e0;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
}

.relation-option.selected {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: #667eea;
}

.relation-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.relation-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 添加方式选择器 */
.mode-selector {
  display: flex;
  gap: 20rpx;
  margin-top: 15rpx;
}

.mode-option {
  flex: 1;
  background: #f8f9fa;
  border: 3rpx solid #e0e0e0;
  border-radius: 15rpx;
  padding: 25rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
}

.mode-option.selected {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: #667eea;
}

.mode-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.mode-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

/* 关联提示 */
.link-hint {
  background: #fff3cd;
  border-left: 4rpx solid #ffc107;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.link-hint text {
  font-size: 24rpx;
  color: #856404;
}

.form-input,
.form-picker,
.form-picker-disabled {
  width: 100%;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 35rpx 30rpx;
  font-size: 30rpx;
  border: 2rpx solid #e0e0e0;
  min-height: 100rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #999999;
}

.form-input:focus,
.form-picker:focus {
  background: white;
  border-color: #667eea;
}

.btn-save {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 15rpx;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}
