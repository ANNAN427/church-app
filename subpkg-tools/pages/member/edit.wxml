<!--pages/member/edit.wxml-->
<view class="container">
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入姓名" value="{{memberName}}" bindinput="onNameInput"/>
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <picker mode="selector" range="{{['男', '女']}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="form-picker">{{genderText}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">出生日期</text>
      <picker mode="date" value="{{birthDate}}" bindchange="onBirthChange">
        <view class="form-picker">{{birthDate || '选择日期'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{['在世', '已故']}}" value="{{statusIndex}}" bindchange="onStatusChange">
        <view class="form-picker">{{statusText}}</view>
      </picker>
    </view>

    <button class="btn-save" bindtap="saveMember">保存修改</button>
    <button class="btn-delete" bindtap="deleteMember">删除成员</button>
  </view>
</view>
