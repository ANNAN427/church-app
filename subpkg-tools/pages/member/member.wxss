/* pages/member/member.wxss */
.container {
  padding: 30rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 中心人物 */
.center-person {
  margin-bottom: 40rpx;
}

.person-card {
  background: white;
  border-radius: 30rpx;
  padding: 50rpx 80rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.person-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  margin: 0 auto 25rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
}

.person-avatar.male {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.person-avatar.female {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.person-name {
  font-size: 48rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.person-relation {
  font-size: 32rpx;
  color: #667eea;
  font-weight: 600;
}

/* 关系区域 */
.relation-section {
  display: flex;
  gap: 30rpx;
  margin-bottom: 40rpx;
  justify-content: center;
  flex-wrap: wrap;
}

.relation-section.elders {
  margin-top: 20rpx;
}

.relation-section.peers {
  align-items: center;
}

.relation-section.juniors {
  margin-bottom: 60rpx;
}

/* 添加按钮 */
.add-btn {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  min-width: 200rpx;
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.add-text {
  font-size: 28rpx;
  color: #666;
}

/* 已有成员 */
.existing-member {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  min-width: 200rpx;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-bottom: 15rpx;
}

.member-avatar.male {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.member-avatar.female {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.member-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 底部操作栏 */
.action-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: auto;
}

.btn-delete,
.btn-edit,
.btn-tree,
.btn-cancel {
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-delete {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: white;
}

.btn-edit {
  background: linear-gradient(135deg, #ffa502 0%, #ff7f50 100%);
  color: white;
}

.btn-tree {
  background: linear-gradient(135deg, #2ed573 0%, #7bed9f 100%);
  color: white;
}

.btn-cancel {
  background: white;
  color: #667eea;
  border: 2rpx solid #667eea;
}
