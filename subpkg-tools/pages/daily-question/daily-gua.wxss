/* Container */
.container {
  width: 100%;
  height: 100vh;
  background: #0a0a1a;
  position: relative;
  overflow: hidden;
}

/* Stars Background */
.stars-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: radial-gradient(ellipse at center, #1a1a3e 0%, #0a0a1a 70%);
  z-index: 0;
}

/* Bagua Background - full screen */
.bagua-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0.35;
  z-index: 1;
  pointer-events: none;
  animation: baguaFloat 6s ease-in-out infinite;
}
@keyframes baguaFloat {
  0%, 100% { opacity: 0.35; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(1.02); }
}

/* Content overlay - flex column for title + progress, absolute for rest */
.content-overlay {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

/* Page Title */
.page-title {
  text-align: center;
  z-index: 10;
  flex-shrink: 0;
}
.page-title .title-main {
  display: block;
  font-size: 48rpx;
  color: #f5c542;
  font-weight: 700;
  letter-spacing: 12rpx;
  text-shadow: 0 0 30rpx rgba(245,197,66,0.4);
}
.page-title .title-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(245,197,66,0.6);
  margin-top: 12rpx;
  letter-spacing: 6rpx;
}

.back-btn-plain {
  position: fixed;
  top: calc(var(--status-bar-height, 44px) + 8px);
  left: 16rpx;
  z-index: 101;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
}

/* ============================================
   Coins - absolute at bottom edge of bagua
   ============================================ */
.coin-section {
  position: absolute;
  top: 38vh;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 30rpx;
  z-index: 10;
  pointer-events: none;
}
.coin {
  width: 160rpx;
  height: 160rpx;
  position: relative;
}
.coin-img {
  width: 100%;
  height: 100%;
}
.coin.flipping .coin-img {
  animation: coinFlip 0.6s ease-in-out;
}
@keyframes coinFlip {
  0% { transform: rotateY(0); }
  100% { transform: rotateY(360deg); }
}

/* ============================================
   Turtle Wrapper - positioned BELOW bagua plate
   ============================================ */
.turtle-wrapper {
  position: absolute;
  top: 68vh;
  left: 50%;
  transform: translateX(-50%);
  width: 320rpx;
  height: 320rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* Golden ring frame - outer */
.turtle-ring {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(245, 197, 66, 0.5);
  box-shadow: 0 0 30rpx rgba(245, 197, 66, 0.15), inset 0 0 30rpx rgba(245, 197, 66, 0.08);
  z-index: 4;
  animation: ringPulse 3s ease-in-out infinite;
}
@keyframes ringPulse {
  0%, 100% { box-shadow: 0 0 30rpx rgba(245, 197, 66, 0.15), inset 0 0 30rpx rgba(245, 197, 66, 0.08); }
  50% { box-shadow: 0 0 50rpx rgba(245, 197, 66, 0.3), inset 0 0 50rpx rgba(245, 197, 66, 0.15); }
}

/* Golden ring frame - inner */
.turtle-ring-inner {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 296rpx;
  height: 296rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(245, 197, 66, 0.25);
  z-index: 4;
}

/* Circular mask container - clips turtle to circle */
.turtle-mask {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  overflow: hidden;
  z-index: 6;
  background: radial-gradient(circle, rgba(30, 55, 90, 0.5) 0%, rgba(15, 25, 50, 0.3) 60%, transparent 100%);
}

/* Turtle Image - local transparent PNG, NO mix-blend-mode */
.turtle-interactive {
  width: 100%;
  height: 100%;
  touch-action: none;
  -webkit-tap-highlight-color: transparent;
  -webkit-user-select: none;
  user-select: none;
  transition: transform 0.3s ease;
  filter: drop-shadow(0 0 20rpx rgba(245, 197, 66, 0.15));
  animation: turtleBreathe 3s ease-in-out infinite;
}
@keyframes turtleBreathe {
  0%, 100% { transform: scale(1) translateY(0); filter: drop-shadow(0 0 20rpx rgba(245, 197, 66, 0.15)); }
  50% { transform: scale(1.03) translateY(-4rpx); filter: drop-shadow(0 0 35rpx rgba(245, 197, 66, 0.3)); }
}

/* Turtle glow effect underneath */
.turtle-glow {
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 40rpx;
  background: radial-gradient(ellipse, rgba(245, 197, 66, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 4;
  opacity: 0;
  transition: opacity 0.3s ease, width 0.3s ease;
}
.turtle-glow.glow-active {
  opacity: 1;
  width: 320rpx;
  background: radial-gradient(ellipse, rgba(245, 197, 66, 0.5) 0%, rgba(255, 152, 0, 0.2) 40%, transparent 70%);
}

/* Energy Rings - radiate outward on press */
.energy-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(245, 197, 66, 0.4);
  z-index: 3;
  pointer-events: none;
}
.ring-1 {
  animation: ringExpand 1.2s ease-out infinite;
}
.ring-2 {
  animation: ringExpand 1.2s ease-out infinite 0.4s;
}
.ring-3 {
  animation: ringExpand 1.2s ease-out infinite 0.8s;
}
@keyframes ringExpand {
  0% { width: 120rpx; height: 120rpx; opacity: 0.8; border-color: rgba(245, 197, 66, 0.6); }
  100% { width: 500rpx; height: 500rpx; opacity: 0; border-color: rgba(255, 152, 0, 0.1); }
}

/* Pressing state - turtle responds */
.turtle-wrapper.pressing .turtle-interactive {
  transform: scale(1.08);
  filter: drop-shadow(0 0 40rpx rgba(245, 197, 66, 0.6)) drop-shadow(0 0 80rpx rgba(255, 152, 0, 0.3));
}
.turtle-wrapper.pressing .turtle-ring {
  border-color: rgba(245, 197, 66, 0.8);
  box-shadow: 0 0 60rpx rgba(245, 197, 66, 0.4), inset 0 0 60rpx rgba(245, 197, 66, 0.2);
}
.turtle-wrapper.shaking .turtle-mask {
  animation: shake 0.1s ease-in-out infinite alternate;
}
@keyframes shake {
  0% { transform: translateX(-3rpx); }
  100% { transform: translateX(3rpx); }
}

/* Long-press progress bar - at top of page */
.long-press-progress {
  position: fixed;
  top: 240rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
  pointer-events: none;
}
.progress-bar {
  width: 300rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f5c542, #ff9800);
  border-radius: 4rpx;
  transition: width 0.1s linear;
}
.progress-text {
  font-size: 22rpx;
  color: rgba(245, 197, 66, 0.7);
}

/* Action tip - below turtle */
.action-tip {
  position: absolute;
  top: 94vh;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 28rpx;
  color: rgba(245, 197, 66, 0.5);
  z-index: 10;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.action-tip.tip-hidden {
  opacity: 0;
}

/* Result Modal */
.result-modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-overlay-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.7);
}
.modal-content {
  position: relative;
  z-index: 101;
  width: 80%;
  background: linear-gradient(135deg, #1a1a3e, #0f0f2a);
  border: 2rpx solid rgba(245, 197, 66, 0.3);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 0 60rpx rgba(245, 197, 66, 0.15);
}
.modal-header {
  text-align: center;
  margin-bottom: 30rpx;
}
.gua-char {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #f5c542;
  margin-bottom: 10rpx;
}
.gua-num {
  font-size: 28rpx;
  color: rgba(245, 197, 66, 0.6);
}
.gua-poem {
  font-size: 32rpx;
  color: #e0d0b0;
  text-align: center;
  line-height: 2;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(245, 197, 66, 0.15);
  border-bottom: 1rpx solid rgba(245, 197, 66, 0.15);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.poem-line {
  display: block;
  letter-spacing: 4rpx;
}
.gua-detail-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: rgba(245, 197, 66, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid rgba(245, 197, 66, 0.3);
}
.detail-label {
  font-size: 24rpx;
  color: rgba(245, 197, 66, 0.5);
  margin-bottom: 10rpx;
}
.detail-text {
  font-size: 26rpx;
  color: #c0b090;
  line-height: 1.6;
}
.restart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #f5c542, #e0a030);
  border-radius: 40rpx;
  color: #1a1a3e;
  font-size: 30rpx;
  font-weight: bold;
}
