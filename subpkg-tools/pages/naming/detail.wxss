/* pages/naming/detail.wxss */
.container {
  padding: 30rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}

.name-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 50rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.3);
}

.name-text {
  font-size: 64rpx;
  color: white;
  font-weight: bold;
}

.name-score {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  padding: 15rpx 40rpx;
  border-radius: 50rpx;
  font-size: 36rpx;
  font-weight: bold;
}

.detail-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.wuxing-display {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.wuxing-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.element-icon {
  font-size: 40rpx;
  width: 60rpx;
}

.element-name {
  font-size: 28rpx;
  color: #333;
  width: 60rpx;
}

.element-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.element-fill {
  height: 100%;
  border-radius: 10rpx;
}

.element-fill.metal { background: linear-gradient(90deg, #ffd700, #ffed4e); }
.element-fill.wood { background: linear-gradient(90deg, #4caf50, #8bc34a); }
.element-fill.water { background: linear-gradient(90deg, #2196f3, #64b5f6); }
.element-fill.fire { background: linear-gradient(90deg, #f44336, #ff7043); }
.element-fill.earth { background: linear-gradient(90deg, #795548, #a1887f); }

.score-display {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.score-number {
  font-size: 72rpx;
  color: white;
  font-weight: bold;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.score-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.score-label-small {
  font-size: 28rpx;
  color: #666;
}

.score-value {
  font-size: 32rpx;
  color: #667eea;
  font-weight: bold;
}

.interpretation {
  font-size: 28rpx;
  color: #666;
  line-height: 2;
  text-align: justify;
}

.btn-share {
  background: linear-gradient(135deg, #07c16b 0%, #05a55b 100%);
  color: white;
  border: none;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 107, 0.3);
}
