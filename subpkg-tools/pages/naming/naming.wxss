/* pages/naming/naming.wxss - v9 简洁版 */
.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

.header {
  text-align: center;
  padding: 30rpx 0;
}

.title {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 15rpx;
  text-align: left;
}

.form-input {
  width: 100%;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 25rpx;
  min-height: 80rpx;
  line-height: 40rpx;
  font-size: 30rpx;
  border: 2rpx solid #e9ecef;
  text-align: left;
}

.inline-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.option-label {
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 15rpx;
  border-radius: 8rpx;
}

.option-circle {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
}

.option-circle.selected {
  background: #667eea;
  border-color: #667eea;
}

.option-rect {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
}

.option-rect.selected {
  background: #667eea;
  border-color: #667eea;
}

.option-label.selected {
  background: rgba(102, 126, 234, 0.1);
}

.btn-generate {
  width: 100%;
  background: #667eea;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 25rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

.results-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.name-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.name-item {
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 30rpx;
}

.name-item:last-child {
  border-bottom: none;
}

.name-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: left;
}

.name-detail {
  margin-bottom: 20rpx;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 8rpx;
}

.detail-line {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 10rpx;
  text-align: left;
}

.name-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.meta-score {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.meta-meaning {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}

.name-actions {
  display: flex;
  gap: 15rpx;
}

.btn-action {
  flex: 1;
  font-size: 26rpx;
  padding: 15rpx;
  border-radius: 8rpx;
  border: 2rpx solid #667eea;
  color: #667eea;
  background: white;
}

.btn-regenerate {
  width: 100%;
  background: #f093fb;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 25rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin-top: 30rpx;
}

.collected-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: left;
}

.collected-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.collected-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border-left: 4rpx solid #ffd700;
}

.collected-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
}

.collected-detail {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  margin-left: 20rpx;
}

.btn-remove {
  font-size: 24rpx;
  color: #ff4444;
  background: white;
  border: 2rpx solid #ff4444;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  margin-left: 15rpx;
}

.hint-section {
  background: #fff9e6;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #ffe082;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  text-align: left;
}
