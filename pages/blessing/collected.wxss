/* 已收集福卡列表样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a0a00 0%, #2d1507 50%, #1a0a00 100%);
  padding: 30rpx;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 20rpx 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #f0c040;
}

.count {
  font-size: 26rpx;
  color: #d4a040;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 10rpx;
}

.card-item {
  width: 48%;
  margin-bottom: 30rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(240, 192, 64, 0.3);
}

.card-image {
  width: 100%;
  height: 320rpx;
}

.card-info {
  padding: 16rpx;
}

.card-blessing {
  display: block;
  font-size: 24rpx;
  color: #f0c040;
  margin-bottom: 8rpx;
}

.card-date {
  display: block;
  font-size: 20rpx;
  color: #a08030;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #f0c040;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #a08030;
}
