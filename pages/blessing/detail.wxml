<view class="container">
  <!-- 远程福卡图片 -->
  <view class="card-wrapper">
    <image wx:if="{{cardUrl}}" class="card-image" src="{{cardUrl}}" mode="aspectFit" bindload="onImageLoad" binderror="onImageError" />
    <view wx:elif="{{imageError}}" class="card-placeholder">
      <text class="card-title">{{cardName}}</text>
      <text class="card-blessing">图片加载失败</text>
      <text class="card-footer">请检查网络后重试</text>
    </view>
    <view wx:else class="card-placeholder">
      <text class="card-title">{{cardName}}</text>
      <text class="card-blessing">{{blessingText}}</text>
      <text class="card-footer">加载中...</text>
    </view>
  </view>

  <!-- v36: 隐藏 Canvas（用于本地渲染保存，不依赖域名配置） -->
  <canvas canvas-id="saveCanvas" style="width:600px;height:1200px;position:absolute;left:-9999px;top:-9999px;"></canvas>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <button class="btn-save" bindtap="onSaveImage" disabled="{{saving}}">
      <text wx:if="{{saving}}">保存中...</text>
      <text wx:else>保存到相册</text>
    </button>
    <button class="btn-share" open-type="share">
      分享好友
    </button>
  </view>
</view>
