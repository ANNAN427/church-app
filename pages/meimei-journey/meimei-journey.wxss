/* ========== v40: 美美历程全面视觉升级 ========== */

/* 页面容器 - 星空渐变背景 + 微动画 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  background-size: 400% 400%;
  animation: gradientShift 8s ease infinite;
  padding: 0 24rpx;
  padding-bottom: 180rpx;
  position: relative;
  overflow: hidden;
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* 背景装饰光晕 */
.page-container::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  animation: glowFloat 6s ease-in-out infinite;
}

.page-container::after {
  content: '';
  position: absolute;
  bottom: 200rpx;
  left: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  animation: glowFloat 8s ease-in-out infinite reverse;
}

@keyframes glowFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; }
  50% { transform: translateY(-30rpx) scale(1.1); opacity: 1; }
}

/* 标题区 */
.header {
  padding: 60rpx 20rpx 16rpx;
  text-align: center;
  position: relative;
  z-index: 2;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
  letter-spacing: 4rpx;
}

/* Tab 栏 - 玻璃拟态 */
.tab-bar {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 10rpx;
  margin: 16rpx 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 32rpx;
  backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 2;
}

.tab-item {
  padding: 16rpx 36rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  background: transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.active {
  color: #764ba2;
  background: #fff;
  font-weight: 700;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transform: scale(1.02);
}

/* 梦想列表 */
.dream-list {
  padding-top: 8rpx;
  position: relative;
  z-index: 2;
}

/* 空状态 - 增强 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  animation: emptyFloat 4s ease-in-out infinite;
}

@keyframes emptyFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.empty-illustration {
  font-size: 160rpx;
  margin-bottom: 30rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.1));
}

.empty-text {
  font-size: 34rpx;
  color: #fff;
  margin-bottom: 12rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.empty-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 50rpx;
  text-align: center;
  line-height: 1.6;
}

.create-btn {
  padding: 28rpx 72rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: 50rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 32rpx rgba(255, 165, 0, 0.4);
  transition: all 0.25s ease;
}

.create-btn:active {
  transform: scale(0.95);
}

/* 梦想卡片 - 玻璃拟态增强 */
.dream-card {
  margin-bottom: 28rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.dream-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea, #764ba2, #FFD700);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.dream-card:active::before {
  opacity: 1;
}

.dream-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.dream-card.ongoing {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08), rgba(118, 75, 162, 0.08));
  border-left: 8rpx solid #667eea;
}

.dream-card.ongoing::before {
  opacity: 1;
  background: linear-gradient(90deg, #667eea, #764ba2);
}

.dream-card.completed {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.08), rgba(255, 165, 0, 0.08));
  border-left: 8rpx solid #FFD700;
}

.dream-card.completed::before {
  opacity: 1;
  background: linear-gradient(90deg, #FFD700, #FFA500);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.card-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-status-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  color: #fff;
  white-space: nowrap;
  margin-left: 16rpx;
}

.dream-card.ongoing .card-status-tag {
  background: linear-gradient(135deg, #667eea, #764ba2);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.dream-card.completed .card-status-tag {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  box-shadow: 0 2rpx 8rpx rgba(255, 165, 0, 0.3);
}

.card-deadline {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-deadline::before {
  content: '\1F4C5';
  font-size: 28rpx;
}

.completed-note {
  color: #B8860B;
  font-weight: 600;
  margin-left: 8rpx;
}

.card-energy {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.card-energy::after {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  background: #FFD700;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(255, 215, 0, 0.6);
}

/* 倒计时卡片 */
.card-countdown {
  margin-top: 20rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #667eea;
  text-align: center;
  font-weight: 500;
  border: 1rpx solid rgba(102, 126, 234, 0.15);
}

/* 弹窗遮罩 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(4rpx);
  animation: fadeIn 0.3s ease;
}

/* 表单卡片 - 玻璃拟态 */
.form-card {
  width: 88%;
  max-height: 80vh;
  overflow-y: auto;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.form-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #333;
  text-align: center;
  margin-bottom: 36rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  padding: 24rpx 28rpx;
  min-height: 80rpx;
  line-height: 32rpx;
  background: linear-gradient(135deg, #F8F9FA, #F0F1F3);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-input:focus {
  background: #fff;
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.picker-display {
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #F8F9FA, #F0F1F3);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid transparent;
}

.picker-display:active {
  border-color: #667eea;
  background: #fff;
}

/* 按钮区 */
.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.btn-cancel {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #888;
  background: #F0F1F3;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-cancel:active {
  transform: scale(0.95);
  background: #E5E7EB;
}

.btn-prev {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-prev:active {
  transform: scale(0.95);
}

.btn-next {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s ease;
}

.btn-next:active {
  transform: scale(0.95);
}

.btn-submit {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(255, 165, 0, 0.4);
  transition: all 0.2s ease;
}

.btn-submit:active {
  transform: scale(0.95);
}

/* 详情卡片 */
.detail-card {
  width: 85%;
  background: #fff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.3s ease;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #F0F1F3;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #333;
}

.detail-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
  transition: all 0.2s ease;
}

.detail-close:active {
  color: #333;
  transform: scale(1.1);
}

.detail-body {
  margin-bottom: 32rpx;
}

.detail-info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F8F9FA;
}

.detail-label {
  font-size: 28rpx;
  color: #888;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.detail-hint {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08), rgba(118, 75, 162, 0.08));
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #667eea;
  text-align: center;
  border: 1rpx solid rgba(102, 126, 234, 0.15);
}

.detail-actions {
  display: flex;
  gap: 16rpx;
}

.btn-achieve {
  flex: 2;
  padding: 26rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s ease;
}

.btn-achieve:active {
  transform: scale(0.95);
}

.btn-delete {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-delete:active {
  transform: scale(0.95);
  background: rgba(255, 107, 107, 0.2);
}

/* 庆祝动画 */
.celebration {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  animation: celebrationFade 3s ease-out forwards;
}

.celebration-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: celebrationBounce 0.6s ease-out;
}

.celebration-emoji {
  font-size: 140rpx;
  animation: celebrationSpin 2s ease-in-out;
}

.celebration-text {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: 800;
  margin-top: 24rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

@keyframes celebrationFade {
  0% { opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes celebrationBounce {
  0% { transform: scale(0.5); opacity: 0; }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes celebrationSpin {
  0% { transform: rotate(0deg) scale(0.5); }
  50% { transform: rotate(180deg) scale(1.2); }
  100% { transform: rotate(360deg) scale(1); }
}

/* 4步向导样式 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  padding: 0 20rpx;
}

.step-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  font-weight: 700;
  transition: all 0.3s ease;
}

.step-dot.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  transform: scale(1.05);
}

.step-line {
  width: 52rpx;
  height: 6rpx;
  background: #E5E7EB;
  margin: 0 8rpx;
  border-radius: 3rpx;
  transition: all 0.3s ease;
}

.step-line.active {
  background: linear-gradient(90deg, #667eea, #764ba2);
}

/* 步骤内容 */
.step-content {
  margin-bottom: 20rpx;
}

.step-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.step-emoji {
  font-size: 40rpx;
}

.step-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #333;
}

.step-poem {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F8F9FA, #F0F1F3);
  border-radius: 20rpx;
  border-left: 6rpx solid #667eea;
}

.step-poem text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 48rpx;
  margin-bottom: 6rpx;
}

/* 确认卡片 */
.confirm-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 0;
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.08);
}

.confirm-row:last-child {
  border-bottom: none;
}

.confirm-label {
  font-size: 28rpx;
  color: #888;
}

.confirm-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 暖心小贴士 */
.tip-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FFF9F0, #FFF3E6);
  border-radius: 20rpx;
  border: 1rpx solid rgba(212, 160, 23, 0.15);
}

.tip-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #D4A017;
  margin-bottom: 16rpx;
  text-align: center;
}

.tip-item {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.8;
  display: flex;
  gap: 8rpx;
}

.tip-item::before {
  content: '\2728';
  font-size: 24rpx;
}

/* 底部固定新增区域 */
.bottom-add-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(102, 126, 234, 0.95) 0%, rgba(102, 126, 234, 0) 100%);
  z-index: 10;
}

.bottom-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 32rpx 48rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  box-shadow: 0 12rpx 36rpx rgba(255, 165, 0, 0.5);
  transition: all 0.2s ease;
}

.bottom-add-btn:active {
  transform: scale(0.96);
}

.bottom-add-icon {
  font-size: 40rpx;
}

.bottom-add-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 浮动添加梦想按钮 */
.floating-add-btn {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  z-index: 100;
  animation: floatPulse 2s ease-in-out infinite;
}

.floating-plus {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.floating-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 4rpx;
}

@keyframes floatPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* 庆祝Canvas动画 */
.celebration-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

/* 未达成透明弹窗 */
.not-achieved-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: fadeIn 0.4s ease;
  backdrop-filter: blur(4rpx);
}

.not-achieved-dialog {
  width: 580rpx;
  padding: 64rpx 44rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  animation: scaleIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.not-achieved-emoji {
  font-size: 88rpx;
}

.not-achieved-text {
  font-size: 30rpx;
  color: #667eea;
  line-height: 1.8;
  text-align: center;
  font-weight: 500;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 暖心结语 */
.closing-text {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF3E6 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(212, 160, 23, 0.2);
}

.closing-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #D4A017;
  margin-bottom: 16rpx;
  display: block;
  text-align: center;
}

.closing-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.closing-body text {
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.8;
  text-align: left;
}
