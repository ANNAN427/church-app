.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  position: relative;
  background: #0d0d0d;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  opacity: 0.5;
}

.content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  min-height: 100vh;
  justify-content: flex-start;
  padding-top: 150rpx;
}

.music-scroll {
  width: 100%;
  margin-bottom: 40rpx;
}

.music-list {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  white-space: nowrap;
}

.music-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  min-width: 200rpx;
}

.music-item.active {
  background: rgba(255, 255, 255, 0.25);
}

.music-name {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.music-duration {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.share-btn {
  position: fixed;
  bottom: 180rpx;
  right: 40rpx;
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #d4a574 0%, #b8956a 100%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(212, 165, 116, 0.4);
  z-index: 200;
  border: none;
}

.share-btn::after {
  border: none;
}

.share-text {
  font-size: 26rpx;
  color: #fff;
}
