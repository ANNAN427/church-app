page {
  background: #f5f5f5;
}
.container {
  padding: 30rpx;
}
.header {
  text-align: center;
  padding: 40rpx 0;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}
.form-item {
  margin-bottom: 30rpx;
}
.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}
.input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.tip-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 30rpx;
  padding: 15rpx;
  background: #fff8f0;
  border-radius: 8rpx;
  border-left: 4rpx solid #d4a574;
}
.submit-btn {
  background: linear-gradient(135deg, #d4a574, #b8860b);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  height: 80rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}
