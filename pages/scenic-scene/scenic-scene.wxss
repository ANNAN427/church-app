/* pages/scenic-scene/scenic-scene.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f0ff 0%, #fafafa 50%, #ffffff 100%);
  padding: 0 24rpx 60rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}
.header-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5b3a8c;
}
.header-subtitle {
  font-size: 26rpx;
  color: #9a7ab5;
  margin-top: 6rpx;
}

.scene-list {
  margin: 0 -10rpx;
}

.scene-card {
  margin: 10rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(91, 58, 140, 0.1);
  border: 1rpx solid #ede5f5;
}

.scene-header {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scene-icon {
  font-size: 56rpx;
}

.scene-body {
  padding: 24rpx;
}
.scene-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.scene-location {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.scene-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.scene-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.tag {
  margin: 6rpx 8rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #f0e6ff, #e8d5f5);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #7b4fad;
}
