.bg-image{width:100%;height:100%;position:absolute;top:0;left:0;z-index:1}.altar-area{position:absolute;left:0;right:0;bottom:0;z-index:10;display:flex;flex-direction:column;align-items:center}.gongzhuo-image{width:100%;position:relative;z-index:1}.altar-items{position:absolute;bottom:78%;left:0;right:0;display:flex;justify-content:space-between;align-items:flex-end;padding:0 12%;z-index:2}.candle-container{position:relative;display:flex;flex-direction:column;align-items:center;top:-10rpx}.candle-container:active{opacity:.9}.lazhu-image{height:350rpx;position:relative;z-index:1}.flame-canvas{position:absolute;bottom:95%;left:50%;transform:translate(-50%);width:80px;height:100px;z-index:2}.incense-container{position:relative;display:flex;flex-direction:column;align-items:center;top:-6rpx}.incense-container:active{opacity:.9}.xianglu-image{height:100rpx;position:relative;z-index:1}.smoke-canvas{position:absolute;bottom:66%;left:49%;transform:translate(-50%);width:140px;height:240px;z-index:2}.enterprise-banner{position:absolute;top:32rpx;left:50%;transform:translate(-50%);z-index:20;display:flex;flex-direction:column;align-items:center;background:rgba(20,10,0,.55);border:1rpx solid rgba(212,175,55,.5);border-radius:16rpx;padding:14rpx 28rpx;backdrop-filter:blur(4px);min-width:600rpx;max-width:96%}.enterprise-label{font-size:22rpx;color:rgba(212,175,55,.85);letter-spacing:4rpx;margin-bottom:6rpx}.enterprise-name-row{width:100%;display:flex;align-items:center;justify-content:center;gap:20rpx}.enterprise-name{font-size:32rpx;font-weight:600;color:#f5e6c0;letter-spacing:2rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:75vw;display:inline-block}.enterprise-unbind{font-size:24rpx;color:rgba(212,175,55,.75);border:1rpx solid rgba(212,175,55,.5);border-radius:20rpx;padding:4rpx 16rpx;flex-shrink:0}
/* Enterprise modals */
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:100;display:flex;align-items:center;justify-content:center}
.modal-content{width:85%;max-width:600rpx;background:#fff;border-radius:24rpx;padding:40rpx 30rpx 30rpx;box-shadow:0 8rpx 32rpx rgba(0,0,0,0.3)}
.modal-title{font-size:34rpx;font-weight:bold;color:#333;text-align:center;margin-bottom:30rpx;display:block}
.modal-input{width:100%;height:80rpx;background:#f5f5f5;border-radius:12rpx;padding:0 24rpx;font-size:28rpx;box-sizing:border-box;margin-bottom:24rpx}
.modal-btn-row{display:flex;gap:20rpx;margin-top:20rpx}
.modal-btn{flex:1;height:72rpx;border-radius:36rpx;font-size:28rpx;border:none;display:flex;align-items:center;justify-content:center}
.cancel-btn{background:#f0f0f0;color:#666}
.confirm-btn{background:linear-gradient(135deg,#d4a574,#b8860b);color:#fff}
.new-btn{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff}
.enterprise-list{max-height:400rpx;margin-bottom:20rpx}
.enterprise-item{padding:24rpx;border-bottom:1rpx solid #eee}
.enterprise-item:active{background:#f9f5ee}
.enterprise-item-name{font-size:28rpx;color:#333}
.empty-tip{text-align:center;padding:40rpx;color:#999;font-size:26rpx}
