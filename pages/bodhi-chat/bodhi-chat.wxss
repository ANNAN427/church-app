/* pages/bodhi-chat/bodhi-chat.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #1a0a2e 0%, #2a1a4e 50%, #1a1a3e 100%);
}

/* 头部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx 20rpx;
  background: rgba(255, 215, 0, 0.05);
  border-bottom: 1rpx solid rgba(255, 215, 0, 0.1);
}

.header-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.header-title {
  color: #ffd700;
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
}

.header-subtitle {
  color: rgba(180, 160, 255, 0.7);
  font-size: 24rpx;
  margin-top: 6rpx;
}

/* 聊天区域 */
.chat-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.user-message {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  background: rgba(100, 150, 255, 0.15);
  border: 1rpx solid rgba(100, 150, 255, 0.2);
}

.user-message .avatar {
  background: rgba(255, 150, 100, 0.15);
  border-color: rgba(255, 150, 100, 0.2);
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  position: relative;
}

.ai-bubble {
  background: linear-gradient(135deg, rgba(100, 150, 255, 0.15), rgba(150, 100, 255, 0.15));
  border: 1rpx solid rgba(100, 150, 255, 0.2);
  border-top-left-radius: 4rpx;
}

.user-bubble {
  background: linear-gradient(135deg, rgba(255, 150, 100, 0.2), rgba(255, 200, 100, 0.2));
  border: 1rpx solid rgba(255, 150, 100, 0.2);
  border-top-right-radius: 4rpx;
}

.bubble-text {
  color: rgba(220, 230, 255, 0.9);
  font-size: 28rpx;
  line-height: 1.8;
  word-break: break-all;
}

/* 思考中 */
.thinking-dots {
  display: flex;
  gap: 8rpx;
  padding: 10rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(100, 150, 255, 0.5);
  animation: pulse 1.4s infinite ease-in-out;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
  40% { transform: scale(1); opacity: 0.8; }
}

/* 快捷问题 */
.quick-questions {
  padding: 20rpx;
  margin-bottom: 10rpx;
}

.quick-title {
  color: rgba(255, 215, 0, 0.8);
  font-size: 26rpx;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-item {
  padding: 12rpx 24rpx;
  background: rgba(100, 150, 255, 0.1);
  border: 1rpx solid rgba(100, 150, 255, 0.15);
  border-radius: 20rpx;
  color: rgba(200, 220, 255, 0.8);
  font-size: 24rpx;
}

.quick-item:active {
  background: rgba(100, 150, 255, 0.2);
  border-color: rgba(100, 150, 255, 0.3);
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.3);
  border-top: 1rpx solid rgba(100, 150, 255, 0.1);
  gap: 16rpx;
}

.input-field {
  flex: 1;
  padding: 16rpx 24rpx;
  min-height: 80rpx;
  line-height: 48rpx;
  background: rgba(100, 150, 255, 0.08);
  border: 1rpx solid rgba(100, 150, 255, 0.15);
  border-radius: 24rpx;
  color: rgba(220, 230, 255, 0.9);
  font-size: 28rpx;
}

.send-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #ffd700, #ffa500);
  border-radius: 24rpx;
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: bold;
}

.send-btn.disabled {
  opacity: 0.5;
  background: rgba(100, 150, 255, 0.2);
  color: rgba(180, 200, 255, 0.6);
}
