<!--pages/bodhi-chat/bodhi-chat.wxml-->
<view class="page-container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-icon">🪷</view>
    <view class="header-title">智慧菩提</view>
    <view class="header-subtitle">AI 答疑，智慧引导</view>
  </view>

  <!-- 聊天区域 -->
  <scroll-view class="chat-container" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
    <!-- 欢迎消息 -->
    <view class="message ai-message" id="msg-0">
      <view class="avatar">🪷</view>
      <view class="bubble">
        <text class="bubble-text">善哉善哉，我是智慧菩提。您可以向我提问关于佛法、修行、人生困惑等问题，我将以佛法的智慧为您解答。</text>
      </view>
    </view>

    <!-- 聊天记录 -->
    <view class="message {{item.role === 'user' ? 'user-message' : 'ai-message'}}" 
          wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
      <view class="avatar" wx:if="{{item.role === 'ai'}}">🪷</view>
      <view class="bubble {{item.role === 'user' ? 'user-bubble' : 'ai-bubble'}}">
        <text class="bubble-text">{{item.content}}</text>
      </view>
      <view class="avatar" wx:if="{{item.role === 'user'}}">🧘</view>
    </view>

    <!-- 思考中 -->
    <view class="message ai-message" wx:if="{{isThinking}}">
      <view class="avatar">🪷</view>
      <view class="bubble ai-bubble">
        <view class="thinking-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 快捷问题 -->
  <view class="quick-questions" wx:if="{{messages.length <= 1}}">
    <view class="quick-title">💬 常见问题</view>
    <view class="quick-list">
      <view class="quick-item" wx:for="{{quickQuestions}}" wx:key="index"
            bindtap="sendQuickQuestion" data-question="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input class="input-field" placeholder="请输入您的问题..." 
           value="{{inputText}}" bindinput="onInput" bindconfirm="sendMessage"
           confirm-type="send" disabled="{{isThinking}}" />
    <view class="send-btn {{isThinking ? 'disabled' : ''}}" bindtap="sendMessage">
      发送
    </view>
  </view>
</view>
