/* pages/tree/tree.wxss */
.container {
  padding: 20rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}

.toolbar {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20px;
}

.btn-expand,
.btn-collapse,
.btn-share {
  flex: 1;
  background: white;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-share {
  background: #667eea;
  color: white;
}

/* 没有数据提示 */
.empty-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-back-home {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 25rpx 60rpx;
  font-size: 30rpx;
}

/* 树形容器 */
.tree-scroll {
  width: 100%;
  height: calc(100vh - 200rpx);
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
}

.family-tree {
  min-width: 100%;
}

.generation-level {
  margin-bottom: 60rpx;
}

.generation-title {
  text-align: center;
  font-size: 28rpx;
  color: #667eea;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.member-row {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  flex-wrap: wrap;
}

.member-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
}

.member-box.self .member-avatar {
  border-width: 6rpx;
  border-color: #ff4757;
}

.member-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-bottom: 15rpx;
  border: 3rpx solid #667eea;
}

.member-avatar.male {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.member-avatar.female {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.member-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 连接线 */
.line-down {
  width: 4rpx;
  height: 60rpx;
  background: linear-gradient(to bottom, #667eea, #764ba2);
  margin: 30rpx auto;
  border-radius: 2rpx;
}

/* 查询模式提示 */
.query-hint {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  z-index: 100;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 30rpx;
}

/* 查询结果 */
.result-members {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  padding: 30rpx 0;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  border-radius: 15rpx;
  margin-bottom: 30rpx;
}

.result-member {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.member-avatar-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.member-name-small {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
}

.relation-arrow {
  font-size: 40rpx;
  color: #667eea;
  font-weight: bold;
}

.result-section {
  margin-bottom: 25rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border-left: 4rpx solid #667eea;
}

.result-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.result-item {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 24rpx;
  color: #666;
  min-width: 180rpx;
}

.result-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.result-value.highlight {
  color: #667eea;
  font-weight: bold;
  font-size: 26rpx;
}

.btn-close {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  margin-top: 20rpx;
}
