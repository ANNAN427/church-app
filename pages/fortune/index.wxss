/* pages/fortune/index.wxss - 天经地易抽签页面样式 */

page {
  background: linear-gradient(180deg, #f5e6d3 0%, #f5e6d3 30%, #e6c896 100%);
  min-height: 100vh;
  overflow: hidden;
}

.container {
  position: relative;
  width: 100%;
  min-height: 100vh;
}

/* 菜单按钮 - 圆形样式（和名门望族完全一致） */
.menu-btn {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #d4a843 0%, #b8942b 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 60;
  transition: all 0.3s ease;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid #8b6914;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  cursor: pointer;
}

.menu-btn .menu-icon {
  font-size: 36rpx;
  color: #fff;
}

.left-btn {
  left: 20rpx;
}

.left-btn.menu-open {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-50%) rotate(90deg);
}

.right-btn {
  right: 20rpx;
}

.right-btn.menu-open {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-50%) rotate(90deg);
}

/* 侧边栏菜单 */
.side-menu {
  position: fixed;
  top: 0;
  bottom: 0;
  width: 280rpx;
  background: linear-gradient(135deg, rgba(30, 30, 50, 0.95), rgba(20, 20, 40, 0.98));
  z-index: 50;
  display: flex;
  flex-direction: column;
  padding: 120rpx 30rpx 60rpx;
  gap: 16rpx;
  transition: transform 0.3s ease;
  backdrop-filter: blur(20rpx);
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.5);
}

.left-menu {
  left: 0;
  transform: translateX(-100%);
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
}

.left-menu.show {
  transform: translateX(0);
}

.right-menu {
  right: 0;
  transform: translateX(100%);
  border-left: 1rpx solid rgba(255, 255, 255, 0.1);
}

.right-menu.show {
  transform: translateX(0);
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.98);
}

.menu-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.menu-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  white-space: nowrap;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 40;
  transition: background 0.3s ease;
  pointer-events: none;
}

.mask.show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

/* 背景图片 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 背景遮罩 */
.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(ellipse at center, transparent 0%, rgba(10, 10, 30, 0.7) 100%);
  z-index: 2;
  pointer-events: none;
}

/* 八卦背景 */
.bagua-bg {
  position: absolute;
  top: 35%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  z-index: 4;
  pointer-events: none;
  animation: bagua-float 6s ease-in-out infinite;
}

.bagua-bg.shaking {
  animation: bagua-shake 0.6s ease-in-out infinite;
}

@keyframes bagua-float {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.05); }
}

@keyframes bagua-shake {
  0%, 100% { transform: translate(-50%, -50%) scale(1.08) rotate(-8deg); }
  50% { transform: translate(-50%, -50%) scale(1.12) rotate(8deg); }
}

.bagua-face {
  position: absolute;
  width: 140rpx;
  height: 100rpx;
  border-radius: 8rpx;
  opacity: 0.85;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.qian { background: linear-gradient(135deg, #4a90e2, #357abd); top: 10rpx; left: 50%; transform: translateX(-50%); }
.dui { background: linear-gradient(135deg, #7ed321, #50a82f); top: 60rpx; right: 40rpx; transform: rotate(45deg); }
.li { background: linear-gradient(135deg, #ff6b6b, #ee5a5a); right: 10rpx; top: 50%; transform: translateY(-50%) rotate(90deg); }
.zhen { background: linear-gradient(135deg, #d4a574, #c4915d); bottom: 60rpx; right: 40rpx; transform: rotate(135deg); }
.xun { background: linear-gradient(135deg, #f5f5f5, #e0e0e0); bottom: 10rpx; left: 50%; transform: translateX(-50%) rotate(180deg); }
.kan { background: linear-gradient(135deg, #2c3e50, #1a252f); bottom: 60rpx; left: 40rpx; transform: rotate(225deg); }
.gen { background: linear-gradient(135deg, #f9ca24, #f0932b); left: 10rpx; top: 50%; transform: translateY(-50%) rotate(270deg); }
.kun { background: linear-gradient(135deg, #f6e58d, #ffd32a); top: 60rpx; left: 40rpx; transform: rotate(315deg); }

/* 太极图 */
.taiji {
  position: absolute;
  top: 35%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #000 50%, #fff 50%);
  z-index: 10;
  pointer-events: none;
}

.taiji.rotating {
  animation: taiji-spin 0.6s linear infinite;
}

@keyframes taiji-spin {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

.taiji-yang {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 90rpx;
  height: 90rpx;
  background: #fff;
  border-radius: 50%;
}

.taiji-yin {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 90rpx;
  height: 90rpx;
  background: #000;
  border-radius: 50%;
}

.taiji-dot {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  left: 50%;
  transform: translateX(-50%);
}

.yang-dot { background: #000; top: 30rpx; }
.yin-dot { background: #fff; bottom: 30rpx; }

/* 签筒容器 */
.qiantong-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 20;
  transition: transform 0.3s ease;
}

.qiantong-container:active {
  transform: translate(-50%, -50%) scale(0.96);
}

.qiantong-container.shake-lot {
  animation: shake-lot 0.5s ease-in-out infinite;
}

@keyframes shake-lot {
  0%, 100% { transform: translate(-50%, -50%) rotate(-18deg) translateX(-12rpx); }
  25% { transform: translate(-50%, -50%) rotate(-12deg) translateX(12rpx); }
  50% { transform: translate(-50%, -50%) rotate(-18deg) translateX(-12rpx); }
  75% { transform: translate(-50%, -50%) rotate(-12deg) translateX(12rpx); }
}

.lot-cylinder {
  position: relative;
  width: 140rpx;
  height: 200rpx;
}

.cylinder-body {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 40%, #e74c3c 100%);
  border-radius: 20rpx 20rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.5);
  border: 3rpx solid rgba(255, 255, 255, 0.2);
}

.cylinder-text {
  font-size: 48rpx;
  color: #f9e79f;
  font-weight: bold;
  writing-mode: vertical-rl;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.cylinder-sub {
  font-size: 20rpx;
  color: rgba(249, 231, 159, 0.9);
  margin-top: 20rpx;
  writing-mode: vertical-rl;
  letter-spacing: 4rpx;
}

.cylinder-top {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 150rpx;
  height: 30rpx;
  background: linear-gradient(135deg, #f39c12, #d68910);
  border-radius: 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.cylinder-bottom {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 145rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #922b21, #7b241c);
  border-radius: 40rpx 40rpx 48rpx 48rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.2);
}

.lot-sticks {
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  width: 120rpx;
}

.stick {
  width: 12rpx;
  height: 70rpx;
  background: linear-gradient(180deg, #f4d03f 0%, #d4ac0d 60%, #f4d03f 100%);
  border-radius: 6rpx 6rpx 0 0;
  margin: 0 4rpx;
  box-shadow: 0 -2rpx 6rpx rgba(0, 0, 0, 0.3);
  animation: stick-shake 0.3s ease-in-out infinite;
  animation-play-state: paused;
}

.qiantong-container.shake-lot .stick {
  animation-play-state: running;
}

@keyframes stick-shake {
  0%, 100% { transform: translateY(0) rotate(-5deg); }
  50% { transform: translateY(-8rpx) rotate(5deg); }
}

/* 提示文字 */
.hint-text {
  position: absolute;
  bottom: 150rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 30;
  transition: opacity 0.5s ease;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10rpx);
  padding: 30rpx 60rpx;
  border-radius: 24rpx;
  margin: 0 40rpx;
}

.hint-text.hidden {
  opacity: 0;
  pointer-events: none;
}

.hint-main {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
}

.hint-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.6);
}

/* 签文结果卡片 */
.result-card {
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  max-width: 550rpx;
  background: linear-gradient(135deg, rgba(245, 230, 211, 0.98) 0%, rgba(230, 175, 120, 0.98) 100%);
  border-radius: 24rpx;
  padding: 0;
  box-shadow: 0 12rpx 48rpx rgba(212, 160, 96, 0.4);
  border: 2rpx solid rgba(212, 160, 96, 0.6);
  transition: all 0.5s ease;
  z-index: 30;
  overflow: hidden;
}

.result-card.visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0) scale(1);
}

.result-card.hidden {
  opacity: 0;
  transform: translateX(-50%) translateY(40rpx) scale(0.95);
  pointer-events: none;
}

.result-title {
  font-size: 40rpx;
  color: #c45a3c;
  font-weight: bold;
  text-align: center;
  padding: 24rpx 32rpx 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.result-content {
  font-size: 32rpx;
  color: #3a2a1a;
  line-height: 2.2;
  text-align: center;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  border-left: 4rpx solid #c45a3c;
  border-right: 4rpx solid #c45a3c;
}

.result-content .lot-line {
  margin: 12rpx 0;
  line-height: 2.6;
  text-align: center;
  font-size: 32rpx;
}

/* 按钮区域 */
.result-actions {
  padding: 0 32rpx 24rpx;
  display: flex;
  justify-content: center;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #c45a3c 0%, #a04028 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(196, 90, 60, 0.3);
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.action-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 3rpx;
}

/* 免责声明 */
.disclaimer {
  position: absolute;
  bottom: 30rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 30;
}

.dis-text {
  font-size: 22rpx;
  color: rgba(245, 230, 211, 0.5);
  line-height: 1.7;
  text-align: center;
}

/* AI 解读弹窗 */
.dialog-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog-overlay.show {
  display: flex;
}

.dialog-container {
  width: 92%;
  max-width: 640rpx;
  max-height: 85vh;
  background: linear-gradient(135deg, #f5e6d3 0%, #e6af78 100%);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 56rpx rgba(0, 0, 0, 0.5);
}

.dialog-header {
  position: relative;
  padding: 32rpx 36rpx;
  background: linear-gradient(135deg, #c45a3c, #a04028);
}

.dialog-title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.close-btn {
  position: absolute;
  top: 28rpx;
  right: 32rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.9);
}

.dialog-content {
  padding: 36rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.interpret-item {
  margin-bottom: 32rpx;
}

.item-label {
  font-size: 30rpx;
  color: #c45a3c;
  font-weight: bold;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.item-content {
  font-size: 28rpx;
  color: #3a2a1a;
  line-height: 2;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 16rpx;
}

.advice-section {
  margin-top: 28rpx;
}

.advice-label {
  font-size: 30rpx;
  color: #c45a3c;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.advice-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 20rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 14rpx;
}

.advice-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.advice-text {
  font-size: 24rpx;
  color: #3a2a1a;
  line-height: 1.7;
  flex: 1;
}

/* AI 分析结果弹窗样式 */
.ai-result-dialog .result-content-box {
  padding: 0;
}

.ai-result-dialog .result-text {
  font-size: 28rpx;
  color: #3a2a1a;
  line-height: 2;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.dialog-footer {
  padding: 30rpx 40rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
}

/* AI 分析弹窗样式 */
.analysis-dialog .result-content-box {
  background: rgba(255, 255, 255, 0.8);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.analysis-dialog .result-text {
  font-size: 28rpx;
  color: #3a2a1a;
  line-height: 2;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.name-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
}

.name-input.single-input {
  height: 80rpx;
  padding: 0 24rpx;
}

.name-input.multi-input {
  min-height: 200rpx;
  line-height: 1.6;
}

.datetime-picker .picker-display {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #daa520 0%, #f4d03f 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(218, 165, 32, 0.4);
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.submit-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 3rpx;
}
/* 黄道吉日分析结果样式 */
.result-content-box .section-title {
  color: #c05c41;
  font-size: 22px;
  font-weight: bold;
  margin: 30px 0 15px 0;
  padding: 10px 0;
  border-bottom: 3px solid #c05c41;
  display: block;
}

.result-content-box {
  line-height: 2;
  font-size: 16px;
}