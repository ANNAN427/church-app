<view class="container">
  <!-- Title -->
  <view class="sign-title">{{cardData.sort}} · {{cardData.name}}</view>
  <view class="xiongji">{{cardData.xiongji}}</view>

  <!-- Poetry -->
  <view class="poetry" wx:if="{{poetryLines.length > 0}}">
    <view class="poetry-item" wx:for="{{poetryLines}}" wx:key="*this">
      <text>{{item}}</text>
    </view>
  </view>

  <!-- Story -->
  <view class="sign-story" wx:if="{{cardData.story}}">{{cardData.story}}</view>

  <!-- Meaning -->
  <view class="sign-mean" wx:if="{{cardData.qianshi_mean}}">{{cardData.qianshi_mean}}</view>

  <!-- Tags -->
  <view class="tag" wx:if="{{cardData.shiye || cardData.caifu || cardData.yinyuan || cardData.jiankang}}">
    <view class="tag-item" wx:if="{{cardData.shiye}}">事业：{{cardData.shiye}}</view>
    <view class="tag-item" wx:if="{{cardData.caifu}}">财富：{{cardData.caifu}}</view>
    <view class="tag-item" wx:if="{{cardData.yinyuan}}">姻缘：{{cardData.yinyuan}}</view>
    <view class="tag-item" wx:if="{{cardData.jiankang}}">健康：{{cardData.jiankang}}</view>
  </view>

  <!-- Refresh Button -->
  <view class="btn-wrapper" bindtap="restartDraw">
    <view class="submit-btn">🔮 重启能量</view>
  </view>
</view>
