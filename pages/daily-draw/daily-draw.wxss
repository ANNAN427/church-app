/* pages/daily-draw/daily-draw.wxss */
page {
  background: #f7f7f7;
}

.container {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 40rpx 36rpx 60rpx;
  box-sizing: border-box;
}

.sign-title {
  font-size: 38rpx;
  color: #c45a3c;
  font-weight: bold;
  text-align: center;
  margin-bottom: 8rpx;
}

.xiongji {
  font-size: 28rpx;
  color: #d4a060;
  font-weight: bold;
  text-align: center;
  margin-bottom: 36rpx;
}

/* 诗词卡片 */
.poetry {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #f5e6d3 0%, #e6af78 100%);
  border-radius: 16rpx;
  padding: 36rpx 28rpx 28rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(196, 90, 60, 0.15);
  border: 2rpx solid rgba(212, 160, 96, 0.3);
}

.poetry-item {
  font-size: 32rpx;
  color: #3a2a1a;
  line-height: 2;
  letter-spacing: 6rpx;
  text-align: center;
  font-weight: 500;
  margin-bottom: 12rpx;
  padding: 4rpx 0;
}

.poetry-item:last-child {
  margin-bottom: 0;
}

/* 诗词底部装饰线 */
.poetry::after {
  content: '';
  display: block;
  width: 80rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #c45a3c, transparent);
  margin-top: 16rpx;
}

/* 分隔线 */
.divider {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d4a060, transparent);
  margin: 8rpx 0;
}

/* 故事 / 解签 */
.section-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.section-label {
  font-size: 26rpx;
  color: #c45a3c;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.section-text {
  font-size: 28rpx;
  line-height: 1.9;
  text-align: justify;
  color: #555;
}

/* 运势标签 */
.tag {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin: 10rpx -12rpx 40rpx;
}

.tag-item {
  background: #fff;
  padding: 18rpx 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  color: #555;
  font-size: 26rpx;
  margin: 0 12rpx 20rpx;
  border-left: 4rpx solid #d4a060;
}

/* 底部按钮 */
.btn-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  margin-bottom: 60rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #fdf6ee, #f5e6d3);
  color: #c45a3c;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 100rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.08);
  border: 2rpx solid rgba(196, 90, 60, 0.15);
}
