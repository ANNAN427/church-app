/* pages/prayer-offer/prayer-offer.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  background: rgba(255, 255, 255, 0.1);
}

.header-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.prayer-list {
  flex: 1;
  padding: 30rpx;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  overflow-y: auto;
}

.prayer-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  margin-bottom: 20rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.prayer-item.playing {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.prayer-item.playing .prayer-title,
.prayer-item.playing .prayer-desc,
.prayer-item.playing .prayer-duration {
  color: #fff;
}

.prayer-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.prayer-info {
  flex: 1;
  overflow: hidden;
}

.prayer-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.prayer-desc {
  font-size: 24rpx;
  color: #999;
}

.prayer-duration {
  font-size: 24rpx;
  color: #999;
}

.player-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.player-info {
  flex: 1;
  overflow: hidden;
}

.player-title {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-controls {
  display: flex;
  gap: 30rpx;
}

.control-btn {
  font-size: 50rpx;
  padding: 10rpx 20rpx;
}
