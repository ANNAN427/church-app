.bazi-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.header-section {
  text-align: center;
  padding: 40rpx 0;
  border-bottom: 2rpx solid rgba(218, 165, 32, 0.3);
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #daa520;
  margin-bottom: 16rpx;
  text-shadow: 0 0 20rpx rgba(218, 165, 32, 0.5);
}

.subtitle {
  font-size: 28rpx;
  color: #b8860b;
  letter-spacing: 2rpx;
}

/* 日期选择器区域 */
.datetime-picker-section {
  margin-bottom: 30rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #daa520;
  margin-bottom: 16rpx;
  text-align: center;
}

.picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(218, 165, 32, 0.3);
  border-radius: 16rpx;
  padding: 30rpx;
}

.selected-datetime {
  font-size: 32rpx;
  color: #e0e0e0;
}

.placeholder {
  color: #666;
}

.picker-arrow {
  color: #daa520;
  font-size: 24rpx;
}

/* 分析按钮 */
.analyze-section {
  margin-bottom: 30rpx;
}

.analyze-btn {
  background: linear-gradient(135deg, #daa520 0%, #b8860b 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
}

.analyze-btn[disabled] {
  background: #444;
  opacity: 0.6;
}

.btn-text {
  font-size: 36rpx;
  color: #1a1a2e;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.btn-sub {
  font-size: 24rpx;
  color: rgba(26, 26, 46, 0.8);
}

/* 结果区域 */
.result-section {
  padding-bottom: 40rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: rgba(218, 165, 32, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(218, 165, 32, 0.2);
}

.result-title {
  font-size: 32rpx;
  color: #daa520;
  margin-bottom: 16rpx;
}

.bazi-result {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 8rpx;
}

.result-content {
  padding-bottom: 40rpx;
}

.content-section {
  padding-bottom: 40rpx;
}

.info-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(218, 165, 32, 0.2);
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #daa520;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(218, 165, 32, 0.3);
}

.card-content {
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 1.8;
  text-indent: 2em;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-item {
  background: rgba(218, 165, 32, 0.1);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(218, 165, 32, 0.2);
}

.info-label {
  font-size: 24rpx;
  color: #b8860b;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  color: #daa520;
  font-weight: bold;
}

.bazi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.bazi-item {
  background: rgba(218, 165, 32, 0.1);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  border: 1rpx solid rgba(218, 165, 32, 0.2);
}

.bazi-label {
  font-size: 30rpx;
  color: #daa520;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.bazi-value {
  font-size: 24rpx;
  color: #b8860b;
}

/* 五行结果 */
.wuxing-result {
  padding: 20rpx 0;
}

.wuxing-bar {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 20rpx;
}

.wuxing-item-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  min-width: 100rpx;
}

.wuxing-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wuxing-count {
  font-size: 28rpx;
  color: #e0e0e0;
}

.wuxing-wood-result .wuxing-name {
  color: #4ade80;
}

.wuxing-fire-result .wuxing-name {
  color: #f87171;
}

.wuxing-earth-result .wuxing-name {
  color: #fbbf24;
}

.wuxing-metal-result .wuxing-name {
  color: #e5e7eb;
}

.wuxing-water-result .wuxing-name {
  color: #60a5fa;
}

/* AI 分析 */
.ai-analysis {
  padding: 10rpx 0;
}

.analysis-text {
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 2;
  white-space: pre-wrap;
}

/* 基础知识区域 */
.knowledge-section {
  padding-bottom: 40rpx;
}

.tiangan-section, .dizhi-section {
  margin-bottom: 30rpx;
}

.tiangan-section:last-child, .dizhi-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 30rpx;
  color: #daa520;
  margin-bottom: 20rpx;
  text-align: center;
}

.tiangan-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 16rpx;
}

.tiangan-item, .dizhi-item {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(218, 165, 32, 0.2) 0%, rgba(184, 134, 11, 0.1) 100%);
  border-radius: 50%;
  font-size: 32rpx;
  color: #daa520;
  border: 1rpx solid rgba(218, 165, 32, 0.3);
}

.dizhi-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 16rpx;
}

.wuxing-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 20rpx;
}

.wuxing-item {
  width: 120rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.wuxing-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wuxing-desc {
  font-size: 22rpx;
  color: #b0b0b0;
}

.wuxing-wood .wuxing-name {
  color: #4ade80;
}

.wuxing-fire .wuxing-name {
  color: #f87171;
}

.wuxing-earth .wuxing-name {
  color: #fbbf24;
}

.wuxing-metal .wuxing-name {
  color: #e5e7eb;
}

.wuxing-water .wuxing-name {
  color: #60a5fa;
}

.footer-section {
  text-align: center;
  padding: 40rpx 0;
  border-top: 1rpx solid rgba(218, 165, 32, 0.2);
}

.footer-text {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 4rpx;
}

/* 日期选择器弹窗 */
.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-container {
  width: 100%;
  background: #1a1a2e;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(218, 165, 32, 0.2);
}

.picker-cancel {
  font-size: 30rpx;
  color: #999;
}

.picker-title {
  font-size: 32rpx;
  color: #daa520;
  font-weight: bold;
}

.picker-confirm {
  font-size: 30rpx;
  color: #daa520;
  font-weight: bold;
}

.picker-content {
  height: 500rpx;
  background: #16213e;
}

.datetime-picker {
  width: 100%;
  height: 100%;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 32rpx;
  color: #e0e0e0;
}
